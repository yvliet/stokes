---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="contracts | polyglot boundary invariants | stokes"
  description="Declarative cross-compiler boundary contracts for ClickHouse SQL, Python ETL pipelines, and Rust L7 edge proxies."
>
  <div class="flex min-h-screen flex-col bg-background text-foreground transition-colors selection:bg-neutral-200 dark:selection:bg-neutral-800">
    <Navbar />

    <main class="flex-1">
      <!-- Hero Section -->
      <section class="pt-24 sm:pt-32 pb-16 px-6 text-center">
        <div class="max-w-4xl mx-auto">
          <p class="text-sm text-muted-foreground mb-4 lowercase tracking-normal">contracts</p>
          <h1 class="text-5xl sm:text-6xl font-extralight leading-none tracking-tight mb-6 lowercase">
            any compiler. one invariant contract.
          </h1>
          <p class="text-xl sm:text-2xl text-muted-foreground max-w-3xl mx-auto mb-10 font-light leading-relaxed lowercase">
            declarative boundary specifications across clickhouse sql, python etl pipelines, and rust edge proxies. zero runtime panic.
          </p>
          
          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
            <a 
              href="/cli" 
              class="group/button inline-flex shrink-0 items-center justify-center border border-transparent font-medium whitespace-nowrap outline-none select-none h-12 px-8 text-base bg-foreground text-background hover:bg-foreground/90 transition-all rounded-full cursor-pointer"
            >
              run contract audit
            </a>
            <a 
              href="/#outage-tour" 
              class="group/button inline-flex shrink-0 items-center justify-center border border-transparent font-medium whitespace-nowrap outline-none select-none h-12 px-8 text-base ring-2 ring-foreground/20 bg-foreground/[0.05] text-foreground hover:bg-foreground/[0.12] hover:ring-foreground/40 transition-all rounded-full cursor-pointer"
            >
              see outage case study <span>→</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Centerpiece Showcase Window: Polyglot Boundary Policy -->
      <section class="px-6 pb-20">
        <div class="max-w-5xl mx-auto">
          <div class="rounded-xl border border-border/40 bg-card/30 overflow-hidden shadow-sm">
            <div class="p-4 sm:p-6 space-y-4">
              <div class="flex flex-col rounded-lg border border-border/60 bg-background/80 overflow-hidden text-left">
                <!-- Window Titlebar -->
                <div class="flex items-center justify-between px-4 py-2.5 border-b border-border/40 bg-muted/20">
                  <div class="flex items-center gap-2">
                    <div class="flex gap-1.5">
                      <span class="h-2.5 w-2.5 rounded-full bg-red-500/40"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/40"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-green-500/40"></span>
                    </div>
                    <span class="text-xs text-muted-foreground font-mono">contracts/boundary_policy.yaml (active AST contract)</span>
                  </div>
                  <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-foreground/10 text-foreground">
                    verified 200 signals
                  </span>
                </div>

                <!-- Scope Strip -->
                <div class="px-4 py-2.5 border-b border-border/40 bg-muted/10 flex flex-wrap items-center justify-between gap-3">
                  <div class="flex items-center gap-1.5 text-xs font-mono">
                    <span class="text-muted-foreground">scope:</span>
                    <span class="px-2 py-0.5 rounded bg-foreground/10 text-foreground font-medium">all targets</span>
                    <span class="text-muted-foreground">•</span>
                    <span class="text-muted-foreground">clickhouse sql</span>
                    <span class="text-muted-foreground">•</span>
                    <span class="text-muted-foreground">python etl</span>
                    <span class="text-muted-foreground">•</span>
                    <span class="text-muted-foreground">rust l7 proxy</span>
                  </div>
                  <div class="text-[11px] font-mono text-muted-foreground">
                    digest: <code class="text-foreground">e3b0c442...b855</code>
                  </div>
                </div>

                <!-- Code / Contract Body -->
                <div class="p-4 sm:p-6 font-mono text-xs leading-relaxed space-y-4 overflow-x-auto">
                  <div class="space-y-1 text-muted-foreground">
                    <p class="text-foreground font-semibold"># Stokes Declarative Boundary Contract Specification</p>
                    <p>schema_version: "2026.09.25"</p>
                    <p>target_workspace: "dirichlet-l7-proxy"</p>
                    <p>max_canonical_features: 200</p>
                  </div>

                  <div class="border-t border-border/30 pt-3 space-y-3">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                      <!-- Domain 1: SQL Target -->
                      <div class="p-3 rounded border border-border/40 bg-muted/15 space-y-1.5">
                        <div class="flex items-center justify-between text-[11px]">
                          <span class="text-foreground font-medium">ClickHouse Target</span>
                          <span class="text-emerald-500 font-semibold">MATCH</span>
                        </div>
                        <p class="text-[11px] text-muted-foreground">schema: <code>migrations/001_bot_signals.sql</code></p>
                        <p class="text-[11px] text-muted-foreground">query filter: <code>AND database = currentDatabase()</code></p>
                        <p class="text-[11px] text-muted-foreground">signals: <code>200 canonical cols</code></p>
                        <div class="pt-1 text-[10px] text-emerald-600 dark:text-emerald-400">shard replicas isolated (r0, r1)</div>
                      </div>

                      <!-- Domain 2: Python Target -->
                      <div class="p-3 rounded border border-border/40 bg-muted/15 space-y-1.5">
                        <div class="flex items-center justify-between text-[11px]">
                          <span class="text-foreground font-medium">Python ETL Pipeline</span>
                          <span class="text-emerald-500 font-semibold">MATCH</span>
                        </div>
                        <p class="text-[11px] text-muted-foreground">service: <code>services/feature-pipeline</code></p>
                        <p class="text-[11px] text-muted-foreground">taxonomy: <code>6 security domains (200 feats)</code></p>
                        <p class="text-[11px] text-muted-foreground">payload: <code>payloads/features.json</code></p>
                        <div class="pt-1 text-[10px] text-emerald-600 dark:text-emerald-400">extraction bounded to 200 items</div>
                      </div>

                      <!-- Domain 3: Rust Target -->
                      <div class="p-3 rounded border border-border/40 bg-muted/15 space-y-1.5">
                        <div class="flex items-center justify-between text-[11px]">
                          <span class="text-foreground font-medium">Rust L7 Edge Proxy</span>
                          <span class="text-emerald-500 font-semibold">MATCH</span>
                        </div>
                        <p class="text-[11px] text-muted-foreground">crate: <code>crates/dirichlet-proxy</code></p>
                        <p class="text-[11px] text-muted-foreground">stack buffer: <code>[Feature; 200]</code></p>
                        <p class="text-[11px] text-muted-foreground">degradation: <code>select_nth_unstable_by</code></p>
                        <div class="pt-1 text-[10px] text-emerald-600 dark:text-emerald-400">hot path verified (7.66 ns, 0 B heap)</div>
                      </div>
                    </div>
                  </div>

                  <!-- Invariant Rule Tree Snippet -->
                  <div class="border-t border-border/30 pt-3">
                    <span class="text-muted-foreground"># Mathematical Invariant Enforcement Rule:</span>
                    <pre class="mt-2 text-foreground/90 whitespace-pre overflow-x-auto text-[11px] leading-5"><code>rules:
  - id: "INVARIANT_1_INFALLIBLE_INTAKE"
    assertion: "cardinality_risk_ratio = C_upstream / B_downstream &lt;= 1.0"
    on_violation: "synthesize_zero_alloc_dual_zone_degradation"
    core_zone_capacity: 128   # Zone 0: immune to eviction (priority &gt;= 200)
    adaptive_zone_capacity: 72 # Zone 1: Quickselect sheds untrusted shadow columns
    heap_allocation_limit_bytes: 0</code></pre>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Deep Dive 2-Column Section -->
      <section class="py-20 px-6 border-t border-border/30">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          <!-- Left Column: Problem & Mechanics -->
          <div class="space-y-6">
            <p class="text-xs uppercase tracking-widest text-muted-foreground font-mono">cross-boundary blind spots</p>
            <h2 class="text-3xl font-extralight tracking-tight sm:text-4xl leading-snug lowercase">
              why modern compilers can't protect cross-service boundaries.
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              In heterogeneous distributed systems, individual compilers operate in monolingual silos. `sqlfluff` verifies valid SQL DDL, `mypy` verifies Python dictionary packing, and `rustc` validates local borrow semantics. None of these compilers possess semantic visibility across service boundaries.
            </p>

            <!-- Numbered Steps 01 to 04 -->
            <div class="space-y-4 pt-2">
              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">01</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Analytical Schema Expansion</h3>
                  <p class="text-xs text-muted-foreground mt-1">An RBAC update or migration alters ClickHouse reflection. An unqualified <code>system.columns WHERE table LIKE 'events%'</code> query matches across shard replicas (<code>events_r0</code>, <code>events_r1</code>), expanding emitted columns from 200 to 280 without SQL errors.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">02</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Dynamic ETL Serialization</h3>
                  <p class="text-xs text-muted-foreground mt-1">The Python extraction pipeline queries all columns dynamically. Unrecognized columns are assigned <code>priority = 0</code> and serialized into <code>payloads/features.json</code>. Because the JSON syntax is valid, no pipeline alerts fire.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">03</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Native Stack Panic</h3>
                  <p class="text-xs text-muted-foreground mt-1">The Rust L7 edge proxy converts the 280-item slice into a fixed stack array <code>[Feature; 200]</code> via <code>try_into().unwrap()</code>. Element 201 triggers a <code>TryFromSliceError</code> panic, crashing worker threads and blackholing global traffic.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">04</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Stokes Invariant Shield</h3>
                  <p class="text-xs text-muted-foreground mt-1">Stokes traverses SQL, Python, and Rust ASTs concurrently prior to commits. It detects cardinality mismatches ($280 / 200 = 1.40 &gt; 1.0$) and synthesizes in-place zero-allocation degradation routines.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: AST Diff Window Card -->
          <div class="rounded-xl border border-border/40 bg-card/30 overflow-hidden shadow-sm">
            <div class="p-4">
              <div class="flex flex-col rounded-lg border border-border/60 bg-background/80 overflow-hidden text-left">
                <div class="flex items-center gap-2 px-3 py-2 border-b border-border/40 bg-muted/20">
                  <div class="flex gap-1">
                    <span class="h-2 w-2 rounded-full bg-red-500/40"></span>
                    <span class="h-2 w-2 rounded-full bg-yellow-500/40"></span>
                    <span class="h-2 w-2 rounded-full bg-green-500/40"></span>
                  </div>
                  <span class="text-xs text-muted-foreground font-mono">stokes audit --diff (cross-boundary mismatch)</span>
                </div>

                <div class="p-4 font-mono text-xs leading-relaxed space-y-3">
                  <div class="text-muted-foreground">
                    <span class="text-red-500 font-semibold">DRIFT DETECTED:</span> Cardinality Risk Ratio = 1.40 (280 features &gt; 200 buffer)
                  </div>

                  <div class="bg-muted/30 p-3 rounded border border-border/30 space-y-1 text-[11px]">
                    <p class="text-muted-foreground">// services/feature-pipeline/catalog_sync.py</p>
                    <p class="text-red-500">- query = "SELECT name, type FROM system.columns WHERE table LIKE 'events%'"</p>
                    <p class="text-emerald-500">+ query = "SELECT name, type FROM system.columns WHERE database = currentDatabase() AND table = 'events'"</p>
                    
                    <p class="text-muted-foreground mt-2">// crates/dirichlet-proxy/src/engine/feature_ingest.rs</p>
                    <p class="text-red-500">- raw_features.into_boxed_slice().try_into().unwrap() // PANIC ON #201</p>
                    <p class="text-emerald-500">+ raw_features.select_nth_unstable_by(200, |a, b| b.priority.cmp(&a.priority));</p>
                  </div>

                  <div class="pt-2 text-muted-foreground text-[11px] space-y-1">
                    <p class="text-foreground font-medium">Stokes Autonomous Remediation Result:</p>
                    <p class="text-emerald-500">✓ Transitive catalog qualification: shard replicas excluded</p>
                    <p class="text-emerald-500">✓ In-place partial selection: 80 untrusted shadow columns shed</p>
                    <p class="text-emerald-500">✓ Heap allocation overhead: 0 Bytes (L1 cache aligned)</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3-Column Capability Grid -->
      <section class="max-w-6xl mx-auto px-6 py-20 border-t border-border/30">
        <div class="grid gap-8 md:grid-cols-3">
          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[CLICKHOUSE_AST]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">analytical metadata hygiene</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Enforces <code>database = currentDatabase()</code> predicates across ClickHouse analytical schemas, stopping physical shard replica tables from contaminating dynamic feature extraction pipelines.
            </p>
          </article>

          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[PYTHON_ETL]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">bounded ingestion assertions</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Audits dictionary comprehension loops and feature models in Python extraction daemons, asserting explicit capacity bounds and strict priority ranking before serialization.
            </p>
          </article>

          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[RUST_L7]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">zero-allocation degradation</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Replaces fatal <code>try_into().unwrap()</code> calls with in-place Dual-Zone Quickselect, shedding low-priority shadow columns in 7.66 ns with zero heap reallocations.
            </p>
          </article>
        </div>
      </section>

      <FinalCTA />
    </main>

    <Footer />
  </div>
</BaseLayout>
