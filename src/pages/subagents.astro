---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="subagents | autonomous multi-agent swarm | stokes"
  description="Specialized autonomous worker agents operating concurrently across language boundaries to verify and remediate systems invariants."
>
  <div class="flex min-h-screen flex-col bg-background text-foreground transition-colors selection:bg-neutral-200 dark:selection:bg-neutral-800">
    <Navbar />

    <main class="flex-1">
      <!-- Hero Section (inference.sh style: no backlink, clean lowercase eyebrow) -->
      <section class="pt-24 sm:pt-32 pb-16 px-6 text-center">
        <div class="max-w-4xl mx-auto">
          <p class="text-sm text-muted-foreground mb-4 lowercase tracking-normal">subagents</p>
          <h1 class="text-5xl sm:text-6xl font-extralight leading-none tracking-tight mb-6 lowercase">
            specialized agents. parallel verification.
          </h1>
          <p class="text-xl sm:text-2xl text-muted-foreground max-w-3xl mx-auto mb-10 font-light leading-relaxed lowercase">
            five autonomous worker agents running concurrently over low-latency binary wire ipc to traverse compiler asts and synthesize zero-allocation fixes.
          </p>
          
          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
            <a 
              href="/cli" 
              class="group/button inline-flex shrink-0 items-center justify-center border border-transparent font-medium whitespace-nowrap outline-none select-none h-12 px-8 text-base bg-foreground text-background hover:bg-foreground/90 transition-all rounded-full cursor-pointer"
            >
              deploy swarm locally
            </a>
            <a 
              href="/benchmarks" 
              class="group/button inline-flex shrink-0 items-center justify-center border border-transparent font-medium whitespace-nowrap outline-none select-none h-12 px-8 text-base ring-2 ring-foreground/20 bg-foreground/[0.05] text-foreground hover:bg-foreground/[0.12] hover:ring-foreground/40 transition-all rounded-full cursor-pointer"
            >
              view verification benchmarks <span>→</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Centerpiece Showcase Window: Subagent Swarm Dashboard -->
      <section class="px-6 pb-20">
        <div class="max-w-5xl mx-auto">
          <div class="rounded-xl border border-border/40 bg-card/30 overflow-hidden shadow-sm">
            <div class="p-4 sm:p-6 space-y-4">
              <div class="flex flex-col rounded-lg border border-border/60 bg-background/80 overflow-hidden text-left">
                <!-- Window Titlebar -->
                <div class="flex items-center justify-between px-4 py-2.5 border-b border-border/40 bg-muted/20">
                  <div class="flex items-center gap-2">
                    <div class="flex gap-1.5">
                      <span class="h-2.5 w-2.5 rounded-full bg-red-500/40"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/40"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-green-500/40"></span>
                    </div>
                    <span class="text-xs text-muted-foreground font-mono">stokes subagents --parallel (Bob 2.0 coordinator session)</span>
                  </div>
                  <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-medium">
                    coordinator healthy • 5 workers active
                  </span>
                </div>

                <!-- 5 Subagent Cards with Phosphor Robot SVGs -->
                <div class="p-4 sm:p-6 space-y-4">
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
                    
                    <!-- Worker 1: stokes-sql -->
                    <div class="p-3 rounded-lg border border-border/40 bg-muted/15 space-y-2">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 256 256" class="text-foreground shrink-0">
                            <path d="M200,64H160V48a8,8,0,0,0-16,0V64H112V48a8,8,0,0,0-16,0V64H56A16,16,0,0,0,40,80V192a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V80A16,16,0,0,0,200,64ZM88,128a16,16,0,1,1,16,16A16,16,0,0,1,88,128Zm80,0a16,16,0,1,1,16,16A16,16,0,0,1,168,128Z"></path>
                          </svg>
                          <span class="font-mono text-xs font-semibold text-foreground">stokes-sql</span>
                        </div>
                        <span class="font-mono text-[10px] text-emerald-500 font-medium">12 ms</span>
                      </div>
                      <p class="font-mono text-[11px] text-muted-foreground leading-tight">Tree-sitter SQL AST & catalog reflection.</p>
                      <div class="flex items-center gap-1.5 pt-1 text-[10px] font-mono text-emerald-600 dark:text-emerald-400">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                        <span>events_r0 / r1 parsed</span>
                      </div>
                    </div>

                    <!-- Worker 2: stokes-python -->
                    <div class="p-3 rounded-lg border border-border/40 bg-muted/15 space-y-2">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 256 256" class="text-foreground shrink-0">
                            <path d="M200,64H160V48a8,8,0,0,0-16,0V64H112V48a8,8,0,0,0-16,0V64H56A16,16,0,0,0,40,80V192a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V80A16,16,0,0,0,200,64ZM88,128a16,16,0,1,1,16,16A16,16,0,0,1,88,128Zm80,0a16,16,0,1,1,16,16A16,16,0,0,1,168,128Z"></path>
                          </svg>
                          <span class="font-mono text-xs font-semibold text-foreground">stokes-python</span>
                        </div>
                        <span class="font-mono text-[10px] text-emerald-500 font-medium">18 ms</span>
                      </div>
                      <p class="font-mono text-[11px] text-muted-foreground leading-tight">ETL bounds & dict unpacking loops.</p>
                      <div class="flex items-center gap-1.5 pt-1 text-[10px] font-mono text-emerald-600 dark:text-emerald-400">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                        <span>shadow admission check</span>
                      </div>
                    </div>

                    <!-- Worker 3: stokes-rust -->
                    <div class="p-3 rounded-lg border border-amber-500/40 bg-amber-500/5 space-y-2">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 256 256" class="text-amber-500 shrink-0">
                            <path d="M200,64H160V48a8,8,0,0,0-16,0V64H112V48a8,8,0,0,0-16,0V64H56A16,16,0,0,0,40,80V192a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V80A16,16,0,0,0,200,64ZM88,128a16,16,0,1,1,16,16A16,16,0,0,1,88,128Zm80,0a16,16,0,1,1,16,16A16,16,0,0,1,168,128Z"></path>
                          </svg>
                          <span class="font-mono text-xs font-semibold text-amber-500">stokes-rust</span>
                        </div>
                        <span class="font-mono text-[10px] text-amber-500 font-medium">24 ms</span>
                      </div>
                      <p class="font-mono text-[11px] text-muted-foreground leading-tight">Tree-sitter syn & stack buffer verification.</p>
                      <div class="flex items-center gap-1.5 pt-1 text-[10px] font-mono text-amber-500">
                        <span class="h-1.5 w-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                        <span>drift alert: TryFromSliceError</span>
                      </div>
                    </div>

                    <!-- Worker 4: stokes-proto -->
                    <div class="p-3 rounded-lg border border-border/40 bg-muted/15 space-y-2">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 256 256" class="text-foreground shrink-0">
                            <path d="M200,64H160V48a8,8,0,0,0-16,0V64H112V48a8,8,0,0,0-16,0V64H56A16,16,0,0,0,40,80V192a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V80A16,16,0,0,0,200,64ZM88,128a16,16,0,1,1,16,16A16,16,0,0,1,88,128Zm80,0a16,16,0,1,1,16,16A16,16,0,0,1,168,128Z"></path>
                          </svg>
                          <span class="font-mono text-xs font-semibold text-foreground">stokes-proto</span>
                        </div>
                        <span class="font-mono text-[10px] text-emerald-500 font-medium">8 ms</span>
                      </div>
                      <p class="font-mono text-[11px] text-muted-foreground leading-tight">Repeated field bounds & schema linter.</p>
                      <div class="flex items-center gap-1.5 pt-1 text-[10px] font-mono text-emerald-600 dark:text-emerald-400">
                        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                        <span>repeated bounds checked</span>
                      </div>
                    </div>

                    <!-- Worker 5: stokes-verify -->
                    <div class="p-3 rounded-lg border border-border/40 bg-muted/15 space-y-2">
                      <div class="flex items-center justify-between">
                        <div class="flex items-center gap-1.5">
                          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 256 256" class="text-foreground shrink-0">
                            <path d="M200,64H160V48a8,8,0,0,0-16,0V64H112V48a8,8,0,0,0-16,0V64H56A16,16,0,0,0,40,80V192a16,16,0,0,0,16,16H200a16,16,0,0,0,16-16V80A16,16,0,0,0,200,64ZM88,128a16,16,0,1,1,16,16A16,16,0,0,1,88,128Zm80,0a16,16,0,1,1,16,16A16,16,0,0,1,168,128Z"></path>
                          </svg>
                          <span class="font-mono text-xs font-semibold text-foreground">stokes-verify</span>
                        </div>
                        <span class="font-mono text-[10px] text-muted-foreground font-medium">IDLE</span>
                      </div>
                      <p class="font-mono text-[11px] text-muted-foreground leading-tight">Criterion sandbox & proptest runner.</p>
                      <div class="flex items-center gap-1.5 pt-1 text-[10px] font-mono text-muted-foreground">
                        <span class="h-1.5 w-1.5 rounded-full bg-muted-foreground/50"></span>
                        <span>waiting on patch trigger</span>
                      </div>
                    </div>

                  </div>

                  <!-- Live Wire IPC Log Feed -->
                  <div class="p-3.5 rounded-lg border border-border/40 bg-muted/10 font-mono text-[11px] space-y-1.5 text-muted-foreground">
                    <div class="text-foreground font-semibold flex items-center justify-between">
                      <span>Live Swarm IPC Socket (/tmp/stokes-bob.sock)</span>
                      <span class="text-[10px] font-normal text-muted-foreground">protocol: 4-byte length-prefixed binary framing</span>
                    </div>
                    <p><span class="text-neutral-400">[00:00.012]</span> <span class="text-emerald-500">stokes-sql:</span> schema reflection query matches 280 columns (80 shard replicas in events_r0/r1)</p>
                    <p><span class="text-neutral-400">[00:00.018]</span> <span class="text-emerald-500">stokes-python:</span> detected unbounded shadow column admission in extractor.py (priority = 0)</p>
                    <p><span class="text-neutral-400">[00:00.024]</span> <span class="text-amber-500">stokes-rust:</span> ALERT: Cardinality Risk Ratio = 1.40 (280 features &gt; [Feature; 200] stack capacity)</p>
                    <p><span class="text-neutral-400">[00:00.027]</span> <span class="text-foreground">coordinator:</span> deploying Dual-Zone in-place select_nth_unstable_by remediation to stokes-rust</p>
                    <p><span class="text-neutral-400">[00:00.041]</span> <span class="text-emerald-500">stokes-verify:</span> patch validated: 10,000 proptest cases passed in 1.42s with 0 Bytes heap allocation</p>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Deep Dive 2-Column Section -->
      <section class="py-20 px-6 border-t border-border/30">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          <!-- Left Column: Architecture Explanation -->
          <div class="space-y-6">
            <p class="text-xs uppercase tracking-widest text-muted-foreground font-mono">multi-agent choreography</p>
            <h2 class="text-3xl font-extralight tracking-tight sm:text-4xl leading-snug lowercase">
              domain-isolated workers. low-latency binary wire ipc.
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Traditional single-prompt LLM assistants fail on polyglot architectures because language contexts collide, causing hallucinated syntax and generic advice. Stokes isolates each domain compiler into a dedicated subagent with specialized AST tools, orchestrating them via zero-copy Unix domain sockets.
            </p>

            <!-- Numbered Steps 01 to 04 -->
            <div class="space-y-4 pt-2">
              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">01</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Strict Domain Isolation</h3>
                  <p class="text-xs text-muted-foreground mt-1">Each subagent operates exclusively on its language toolchain (Tree-sitter SQL, Python AST, `syn` / `rustc`). Zero cross-language prompt pollution.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">02</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Length-Prefixed Binary Wire IPC</h3>
                  <p class="text-xs text-muted-foreground mt-1">Subagents communicate with the Stokes coordinator over local Unix Domain Sockets using 4-byte big-endian framing and a 16.6ms render tick coalescer at 60 FPS.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">03</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Multi-Agent Remediation</h3>
                  <p class="text-xs text-muted-foreground mt-1">When drift is flagged, `stokes-sql` proposes `currentDatabase()` filters, `stokes-rust` synthesizes Dual-Zone in-place quickselect, and `stokes-verify` validates the sandbox build.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">04</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Unanimous Attestation</h3>
                  <p class="text-xs text-muted-foreground mt-1">The Stokes coordinator requires all active subagents to sign off before generating the machine-verifiable <code>stokes.lock</code> and human-readable <code>CONFORMANCE.md</code>.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Protocol Handshake Window Card -->
          <div class="rounded-xl border border-border/40 bg-card/30 overflow-hidden shadow-sm">
            <div class="p-4">
              <div class="flex flex-col rounded-lg border border-border/60 bg-background/80 overflow-hidden text-left">
                <div class="flex items-center gap-2 px-3 py-2 border-b border-border/40 bg-muted/20">
                  <div class="flex gap-1">
                    <span class="h-2 w-2 rounded-full bg-red-500/40"></span>
                    <span class="h-2 w-2 rounded-full bg-yellow-500/40"></span>
                    <span class="h-2 w-2 rounded-full bg-green-500/40"></span>
                  </div>
                  <span class="text-xs text-muted-foreground font-mono">protocol/SubagentProgressEvent.json (typed event schema)</span>
                </div>

                <div class="p-4 font-mono text-xs leading-relaxed space-y-3">
                  <pre class="text-foreground/90 whitespace-pre overflow-x-auto text-[11px] leading-5"><code>// Length-Prefixed Binary Event Frame
&#123;
  "event_id": "c7a8e291-f0b4-4e2a-92b1-8d2e82110c4a",
  "timestamp_ns": 1727282400012000000,
  "subagent_id": "stokes-rust",
  "phase": "INVARIANT_EVALUATION",
  "target_file": "crates/dirichlet-proxy/src/engine/feature_ingest.rs",
  "line_offset": 98,
  "ast_node_type": "call_expression",
  "ast_symbol_name": "try_into().unwrap()",
  "status_message": "Fatal TryFromSliceError: 280 elements exceed [Feature; 200]",
  "severity": "CONTRACT_VIOLATION",
  "synthesized_remediation": &#123;
    "algorithm": "select_nth_unstable_by",
    "heap_allocation_limit_bytes": 0,
    "core_reserved_slots": 128
  &#125;
&#125;</code></pre>

                  <div class="pt-2 border-t border-border/30 text-muted-foreground text-[11px] space-y-1">
                    <div class="flex items-center justify-between">
                      <span class="text-foreground font-medium">IPC Socket Transport:</span>
                      <span class="text-emerald-500 font-semibold">Unix Domain Socket (/tmp/stokes-bob.sock)</span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-foreground font-medium">Tick Coalescer Rate:</span>
                      <span class="text-emerald-500 font-semibold">16.6 ms (60 FPS rendering)</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3-Column Capability Grid -->
      <section class="max-w-6xl mx-auto px-6 py-20 border-t border-border/30">
        <div class="grid gap-8 md:grid-cols-3">
          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[STOKES_SQL]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">sql ast inspection</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Traverses ClickHouse syntax trees with native Tree-sitter parsers to enforce database predicate hygiene and prevent shard replica duplication.
            </p>
          </article>

          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[STOKES_RUST]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">memory safety verifier</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Audits fixed buffers, slice unwraps, and SIMD alignment in Rust proxy crates, synthesizing Dual-Zone in-place degradation with zero heap allocations.
            </p>
          </article>

          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[STOKES_VERIFY]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">property-based sandbox</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Executes 10,000 property fuzzing iterations with randomized feature permutations and validates Criterion micro-benchmarks in isolated cargo sandboxes.
            </p>
          </article>
        </div>
      </section>

      <FinalCTA />
    </main>

    <Footer />
  </div>
</BaseLayout>
