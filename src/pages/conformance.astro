---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="conformance | cryptographic lockfile & audit receipt | stokes"
  description="Deterministic boundary verification with stokes.lock and CONFORMANCE.md signed by SHA-256 schema digests."
>
  <div class="flex min-h-screen flex-col bg-background text-foreground transition-colors selection:bg-neutral-200 dark:selection:bg-neutral-800">
    <Navbar />

    <main class="flex-1">
      <!-- Hero Section -->
      <section class="pt-24 sm:pt-32 pb-16 px-6 text-center">
        <div class="max-w-4xl mx-auto">
          <p class="text-sm text-muted-foreground mb-4 lowercase tracking-normal">conformance</p>
          <h1 class="text-5xl sm:text-6xl font-extralight leading-none tracking-tight mb-6 lowercase">
            verifiable lockfile. cryptographic trust.
          </h1>
          <p class="text-xl sm:text-2xl text-muted-foreground max-w-3xl mx-auto mb-10 font-light leading-relaxed lowercase">
            bridge machine-readable schema lockfiles with human-readable audit attestations. immutable sha-256 digests for cross-team compliance.
          </p>
          
          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
            <a 
              href="/cli" 
              class="group/button inline-flex shrink-0 items-center justify-center border border-transparent font-medium whitespace-nowrap outline-none select-none h-12 px-8 text-base bg-foreground text-background hover:bg-foreground/90 transition-all rounded-full cursor-pointer"
            >
              run verification gate
            </a>
            <a 
              href="/#outage-tour" 
              class="group/button inline-flex shrink-0 items-center justify-center border border-transparent font-medium whitespace-nowrap outline-none select-none h-12 px-8 text-base ring-2 ring-foreground/20 bg-foreground/[0.05] text-foreground hover:bg-foreground/[0.12] hover:ring-foreground/40 transition-all rounded-full cursor-pointer"
            >
              explore outage case study <span>→</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Centerpiece Showcase Window: Cryptographic Conformance Matrix -->
      <section class="px-6 pb-20">
        <div class="max-w-5xl mx-auto">
          <div class="rounded-xl border border-border/40 bg-card/30 overflow-hidden shadow-sm">
            <div class="p-4 sm:p-6 space-y-4">
              <div class="flex flex-col rounded-lg border border-border/60 bg-background/80 overflow-hidden text-left">
                <!-- Window Titlebar -->
                <div class="flex items-center justify-between px-4 py-2.5 border-b border-border/40 bg-muted/20">
                  <div class="flex items-center gap-2">
                    <div class="flex gap-1.5">
                      <span class="h-2.5 w-2.5 rounded-full bg-red-500/40"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/40"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-green-500/40"></span>
                    </div>
                    <span class="text-xs text-muted-foreground font-mono">stokes.lock (machine) / CONFORMANCE.md (audit)</span>
                  </div>
                  <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-medium">
                    cryptographically sealed
                  </span>
                </div>

                <!-- Conformance Matrix Content -->
                <div class="p-4 sm:p-6 font-mono text-xs leading-relaxed space-y-4 overflow-x-auto">
                  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-border/40 pb-3">
                    <span class="text-foreground font-bold">Boundary Conformance Certificate</span>
                    <span class="text-[11px] text-muted-foreground">SHA-256: <code class="text-foreground">e3b0c44298fc1c14...855</code></span>
                  </div>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Left: Verification Checks -->
                    <div class="space-y-2">
                      <div class="text-foreground font-semibold text-[11px]">Verification Battery Status</div>
                      <div class="space-y-1.5 text-[11px]">
                        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                          <span>✓</span>
                          <span>ClickHouse Schema: 200 canonical features verified</span>
                        </div>
                        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                          <span>✓</span>
                          <span>Transitive Qualification: WHERE database = currentDatabase() verified</span>
                        </div>
                        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                          <span>✓</span>
                          <span>Rust Proxy: [FeatureDescriptor; 200] stack buffer verified</span>
                        </div>
                        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                          <span>✓</span>
                          <span>Dual-Zone Partitioning: Zone 0 (128 slots) + Zone 1 (72 slots)</span>
                        </div>
                        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                          <span>✓</span>
                          <span>Hot-path latency: 7.66 ns &lt;= 10.0 ns SLA</span>
                        </div>
                        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                          <span>✓</span>
                          <span>Heap allocations: 0 B &lt;= 0 B budget</span>
                        </div>
                        <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                          <span>✓</span>
                          <span>Property fuzz tests: 10,000 / 10,000 passed in 1.42s</span>
                        </div>
                      </div>
                    </div>

                    <!-- Right: Attestation Metadata -->
                    <div class="p-3.5 rounded bg-muted/20 border border-border/40 space-y-2 text-[11px]">
                      <div class="text-foreground font-semibold">Attestation Manifest</div>
                      <div class="space-y-1 text-muted-foreground">
                        <div class="flex justify-between">
                          <span>Target Workspace:</span>
                          <span class="text-foreground font-medium">dirichlet-proxy</span>
                        </div>
                        <div class="flex justify-between">
                          <span>Engine:</span>
                          <span class="text-foreground font-medium">Stokes Multi-Agent Engine</span>
                        </div>
                        <div class="flex justify-between">
                          <span>Verification Time:</span>
                          <span class="text-foreground font-medium">1.42 seconds</span>
                        </div>
                        <div class="flex justify-between">
                          <span>CI Enforcement:</span>
                          <span class="text-emerald-500 font-medium">Strict Pre-Merge Gate</span>
                        </div>
                        <div class="flex justify-between">
                          <span>Author:</span>
                          <span class="text-foreground font-medium">yvliet</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Lockfile Root Digest Block -->
                  <div class="p-3 rounded bg-muted/30 border border-border/30 text-[11px] space-y-1">
                    <span class="text-muted-foreground"># Machine-readable lockfile signature block:</span>
                    <p class="text-foreground/90 pt-1 font-mono break-all">
                      <code>"signature": "stokes-sig-v1:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"</code>
                    </p>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Deep Dive 2-Column Section -->
      <section class="py-20 px-6 border-t border-border/30">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          <!-- Left Column: Architecture Explanation -->
          <div class="space-y-6">
            <p class="text-xs uppercase tracking-widest text-muted-foreground font-mono">tamper-proof boundaries</p>
            <h2 class="text-3xl font-extralight tracking-tight sm:text-4xl leading-snug lowercase">
              how cryptographic lockfiles stop drift before deployment.
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              In modern distributed systems, analytical schemas and microservice buffers live in separate repositories. Stokes binds them cryptographically into a two-tier contract system: a machine-authoritative lockfile (`stokes.lock`) for CI enforcement, and a human-readable audit certificate (`CONFORMANCE.md`) for PR reviews.
            </p>

            <!-- Numbered Steps 01 to 04 -->
            <div class="space-y-4 pt-2">
              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">01</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Cryptographic Schema Hashing</h3>
                  <p class="text-xs text-muted-foreground mt-1">Every column definition, analytical data type, and array buffer size is hashed into a canonical SHA-256 root digest.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">02</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Machine-Authoritative <code>stokes.lock</code></h3>
                  <p class="text-xs text-muted-foreground mt-1">Committed directly into git alongside code. Evaluated by <code>stokes verify --strict</code> in CI/CD pipelines to block PRs on uncontracted drift.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">03</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Human-Readable <code>CONFORMANCE.md</code></h3>
                  <p class="text-xs text-muted-foreground mt-1">Self-documenting markdown certificate summarizing capacity margins, benchmark timings (7.66 ns), and fuzz test coverage for PR reviewers.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">04</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Deterministic PR Gate</h3>
                  <p class="text-xs text-muted-foreground mt-1">Any pull request that adds or modifies analytical schema without updating the corresponding proxy buffers is automatically rejected.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: stokes.lock JSON Window Card -->
          <div class="rounded-xl border border-border/40 bg-card/30 overflow-hidden shadow-sm">
            <div class="p-4">
              <div class="flex flex-col rounded-lg border border-border/60 bg-background/80 overflow-hidden text-left">
                <div class="flex items-center gap-2 px-3 py-2 border-b border-border/40 bg-muted/20">
                  <div class="flex gap-1">
                    <span class="h-2 w-2 rounded-full bg-red-500/40"></span>
                    <span class="h-2 w-2 rounded-full bg-yellow-500/40"></span>
                    <span class="h-2 w-2 rounded-full bg-green-500/40"></span>
                  </div>
                  <span class="text-xs text-muted-foreground font-mono">stokes.lock (canonical JSON representation)</span>
                </div>

                <div class="p-4 font-mono text-xs leading-relaxed space-y-3">
                  <pre class="text-foreground/90 whitespace-pre overflow-x-auto text-[11px] leading-5"><code>&#123;
  "$schema": "https://stokes.dev/schema/v1.json",
  "version": "1.0.0",
  "workspace": "dirichlet-l7-proxy",
  "root_digest": "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
  "invariants": &#123;
    "max_features": 200,
    "max_heap_bytes": 0,
    "max_p99_latency_ns": 10.0,
    "core_reserved_slots": 128
  &#125;,
  "targets": [
    &#123;
      "id": "clickhouse-schema",
      "path": "migrations/001_bot_signals.sql",
      "digest": "sha256:4b227777d4dd1fc61c6f884f48641d02b4d121d3fd328cb08b5531fcacdabf8a"
    &#125;,
    &#123;
      "id": "rust-proxy-buffer",
      "path": "crates/dirichlet-proxy/src/engine/feature_ingest.rs",
      "digest": "sha256:ef2d127de37b942baad06145e54b0c619a1f22327b2ebbcfbec78f5564afe39d"
    &#125;
  ]
&#125;</code></pre>

                  <div class="pt-2 border-t border-border/30 text-muted-foreground text-[11px] space-y-1">
                    <div class="flex items-center justify-between">
                      <span class="text-foreground font-medium">Lockfile Validation Speed:</span>
                      <span class="text-emerald-500 font-semibold">&lt; 15 ms</span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-foreground font-medium">Digest Algorithm:</span>
                      <span class="text-emerald-500 font-semibold">Standard SHA-256</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3-Column Capability Grid -->
      <section class="max-w-6xl mx-auto px-6 py-20 border-t border-border/30">
        <div class="grid gap-8 md:grid-cols-3">
          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[SHA-256 DIGEST]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">tamper-proof invariants</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Cryptographic schema hashing guarantees that any unreviewed field change or buffer size adjustment immediately invalidates the lockfile and triggers verification alerts.
            </p>
          </article>

          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[CI PRE-MERGE GATE]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">automated defense</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Runs as an automated, non-bypassable GitHub Actions check on every pull request, ensuring production deployments never inherit cross-boundary drift.
            </p>
          </article>

          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[AUDIT RECEIPT]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">enterprise compliance</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Produces a self-contained markdown audit manifest (<code>CONFORMANCE.md</code>) complete with timestamp proofs, telemetry metrics, and verifiable SHA-256 signatures.
            </p>
          </article>
        </div>
      </section>

      <FinalCTA />
    </main>

    <Footer />
  </div>
</BaseLayout>
