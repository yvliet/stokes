---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="benchmarks | criterion micro-benchmarks & memory proofs | stokes"
  description="Empirical verification benchmarks: 7.66 ns hot-path latency, 0 Bytes heap allocations, and 10,000 randomized property fuzzing runs."
>
  <div class="flex min-h-screen flex-col bg-background text-foreground transition-colors selection:bg-neutral-200 dark:selection:bg-neutral-800">
    <Navbar />

    <main class="flex-1">
      <!-- Hero Section -->
      <section class="pt-24 sm:pt-32 pb-16 px-6 text-center">
        <div class="max-w-4xl mx-auto">
          <p class="text-sm text-muted-foreground mb-4 lowercase tracking-normal">benchmarks</p>
          <h1 class="text-5xl sm:text-6xl font-extralight leading-none tracking-tight mb-6 lowercase">
            7.66 ns hot path. 0 bytes heap.
          </h1>
          <p class="text-xl sm:text-2xl text-muted-foreground max-w-3xl mx-auto mb-10 font-light leading-relaxed lowercase">
            hardware-level criterion benchmarks proving that safety does not cost throughput. cache-line aligned, zero-allocation memory guarantees.
          </p>
          
          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
            <a 
              href="/conformance" 
              class="group/button inline-flex shrink-0 items-center justify-center border border-transparent font-medium whitespace-nowrap outline-none select-none h-12 px-8 text-base bg-foreground text-background hover:bg-foreground/90 transition-all rounded-full cursor-pointer"
            >
              view conformance cert
            </a>
            <a 
              href="https://github.com/yvliet/dirichlet" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="group/button inline-flex shrink-0 items-center justify-center border border-transparent font-medium whitespace-nowrap outline-none select-none h-12 px-8 text-base ring-2 ring-foreground/20 bg-foreground/[0.05] text-foreground hover:bg-foreground/[0.12] hover:ring-foreground/40 transition-all rounded-full cursor-pointer"
            >
              view benchmark source <span>→</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Centerpiece Showcase Window: Criterion Performance Comparison -->
      <section class="px-6 pb-20">
        <div class="max-w-5xl mx-auto">
          <div class="rounded-xl border border-border/40 bg-card/30 overflow-hidden shadow-sm">
            <div class="p-4 sm:p-6 space-y-4">
              <div class="flex flex-col rounded-lg border border-border/60 bg-background/80 overflow-hidden text-left">
                <!-- Window Titlebar -->
                <div class="flex items-center justify-between px-4 py-2.5 border-b border-border/40 bg-muted/20">
                  <div class="flex items-center gap-2">
                    <div class="flex gap-1.5">
                      <span class="h-2.5 w-2.5 rounded-full bg-red-500/40"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/40"></span>
                      <span class="h-2.5 w-2.5 rounded-full bg-green-500/40"></span>
                    </div>
                    <span class="text-xs text-muted-foreground font-mono">crates/dirichlet-proxy/benches/ingest_benchmark.rs (100k samples)</span>
                  </div>
                  <span class="text-[10px] font-mono uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 font-medium">
                    3.8x faster • 0 b heap
                  </span>
                </div>

                <!-- Benchmarking Bars -->
                <div class="p-4 sm:p-6 space-y-5">
                  <div class="space-y-4 font-mono text-xs">
                    
                    <!-- Row 1: Stokes in-place select -->
                    <div class="space-y-1.5">
                      <div class="flex justify-between items-center text-xs">
                        <span class="text-foreground font-semibold flex items-center gap-2">
                          <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                          stokes in-place select (select_nth_unstable_by)
                        </span>
                        <span class="text-emerald-600 dark:text-emerald-400 font-bold">7.66 ns [P99: 8.12 ns] • 0 B heap</span>
                      </div>
                      <div class="h-3 w-full bg-muted/40 rounded-full overflow-hidden p-0.5">
                        <div class="h-full bg-emerald-500 rounded-full" style="width: 14%;"></div>
                      </div>
                    </div>

                    <!-- Row 2: Standard Heap Vec -->
                    <div class="space-y-1.5">
                      <div class="flex justify-between items-center text-xs">
                        <span class="text-muted-foreground flex items-center gap-2">
                          <span class="h-2 w-2 rounded-full bg-neutral-400"></span>
                          standard heap vector (Vec::with_capacity)
                        </span>
                        <span class="text-muted-foreground">29.74 ns [P99: 41.20 ns] • 1,600 B heap</span>
                      </div>
                      <div class="h-3 w-full bg-muted/40 rounded-full overflow-hidden p-0.5">
                        <div class="h-full bg-neutral-400 dark:bg-neutral-600 rounded-full" style="width: 48%;"></div>
                      </div>
                    </div>

                    <!-- Row 3: Unbounded Sort -->
                    <div class="space-y-1.5">
                      <div class="flex justify-between items-center text-xs">
                        <span class="text-muted-foreground flex items-center gap-2">
                          <span class="h-2 w-2 rounded-full bg-neutral-400"></span>
                          unbounded full sort (slice::sort_by)
                        </span>
                        <span class="text-muted-foreground">142.10 ns [P99: 189.50 ns] • heap alloc</span>
                      </div>
                      <div class="h-3 w-full bg-muted/40 rounded-full overflow-hidden p-0.5">
                        <div class="h-full bg-neutral-300 dark:bg-neutral-700 rounded-full" style="width: 78%;"></div>
                      </div>
                    </div>

                    <!-- Row 4: Naive Clone & Filter -->
                    <div class="space-y-1.5">
                      <div class="flex justify-between items-center text-xs">
                        <span class="text-muted-foreground flex items-center gap-2">
                          <span class="h-2 w-2 rounded-full bg-neutral-400"></span>
                          naive clone & filter (Vec::clone)
                        </span>
                        <span class="text-muted-foreground">312.45 ns [P99: 420.00 ns] • heap thrash</span>
                      </div>
                      <div class="h-3 w-full bg-muted/40 rounded-full overflow-hidden p-0.5">
                        <div class="h-full bg-red-400/60 rounded-full" style="width: 100%;"></div>
                      </div>
                    </div>

                  </div>

                  <!-- Telemetry Summary Cards Strip -->
                  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-3 border-t border-border/40 font-mono text-center">
                    <div class="p-2.5 rounded bg-muted/20 border border-border/30">
                      <div class="text-[10px] text-muted-foreground">HOT-PATH TIME</div>
                      <div class="text-sm font-bold text-foreground mt-0.5">7.66 ns</div>
                    </div>
                    <div class="p-2.5 rounded bg-muted/20 border border-border/30">
                      <div class="text-[10px] text-muted-foreground">HEAP ALLOCATIONS</div>
                      <div class="text-sm font-bold text-emerald-500 mt-0.5">0 Bytes</div>
                    </div>
                    <div class="p-2.5 rounded bg-muted/20 border border-border/30">
                      <div class="text-[10px] text-muted-foreground">PROPTEST BATTERY</div>
                      <div class="text-sm font-bold text-foreground mt-0.5">10,000 runs</div>
                    </div>
                    <div class="p-2.5 rounded bg-muted/20 border border-border/30">
                      <div class="text-[10px] text-muted-foreground">L1 CACHE RESIDENCY</div>
                      <div class="text-sm font-bold text-emerald-500 mt-0.5">100.0%</div>
                    </div>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Deep Dive 2-Column Section -->
      <section class="py-20 px-6 border-t border-border/30">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          <!-- Left Column: Architecture Explanation -->
          <div class="space-y-6">
            <p class="text-xs uppercase tracking-widest text-muted-foreground font-mono">hardware-level guarantees</p>
            <h2 class="text-3xl font-extralight tracking-tight sm:text-4xl leading-snug lowercase">
              why zero heap allocation matters at the l7 edge.
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              In edge network proxies processing millions of packets per second, invoking <code>malloc()</code> or <code>free()</code> on the packet path introduces non-deterministic kernel context switches and memory fragmentation. Stokes enforces algorithms that operate strictly in-place on fixed stack buffers.
            </p>

            <!-- Numbered Steps 01 to 04 -->
            <div class="space-y-4 pt-2">
              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">01</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">L1D Cache Line Residency</h3>
                  <p class="text-xs text-muted-foreground mt-1">Struct <code>FeatureDescriptor</code> is 8 bytes (<code>#[repr(C, align(8))]</code>). 200 descriptors = 1,600 Bytes = exactly 25 contiguous cache lines, consuming only 4.8% of 32 KB L1D cache without pointer indirection.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">02</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Dual-Zone In-Place Partitioning</h3>
                  <p class="text-xs text-muted-foreground mt-1">Zone 0 (128 slots) is reserved for core security heuristics (<code>priority &gt;= 200</code>), immune to eviction. Zone 1 (72 slots) dynamically manages low-priority signals via <code>select_nth_unstable_by</code> with 0 B heap overhead.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">03</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">10,000 Property Fuzz Cases</h3>
                  <p class="text-xs text-muted-foreground mt-1"><code>proptest</code> sweeps 10,000 randomized permutations in 1.42s with zero panics across empty sets, descending order, and adversarial duplicate keys.</p>
                </div>
              </div>

              <div class="flex items-start gap-4">
                <span class="font-mono text-xs text-muted-foreground/80 shrink-0 mt-0.5">04</span>
                <div>
                  <h3 class="text-sm font-semibold text-foreground font-sans">Massive Stress Gate</h3>
                  <p class="text-xs text-muted-foreground mt-1">Under extreme simulation, 100,000 features are partitioned in 10.71 ms with zero heap memory growth, preventing out-of-memory cascading restarts.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Criterion Telemetry Window Card -->
          <div class="rounded-xl border border-border/40 bg-card/30 overflow-hidden shadow-sm">
            <div class="p-4">
              <div class="flex flex-col rounded-lg border border-border/60 bg-background/80 overflow-hidden text-left">
                <div class="flex items-center gap-2 px-3 py-2 border-b border-border/40 bg-muted/20">
                  <div class="flex gap-1">
                    <span class="h-2 w-2 rounded-full bg-red-500/40"></span>
                    <span class="h-2 w-2 rounded-full bg-yellow-500/40"></span>
                    <span class="h-2 w-2 rounded-full bg-green-500/40"></span>
                  </div>
                  <span class="text-xs text-muted-foreground font-mono">target/criterion/feature_ingestion/report.txt</span>
                </div>

                <div class="p-4 font-mono text-xs leading-relaxed space-y-3">
                  <pre class="text-foreground/90 whitespace-pre overflow-x-auto text-[11px] leading-5"><code>feature_partition_200/in_place_select
  time:   [7.6212 ns 7.6601 ns 7.7024 ns]
  slope:  7.6601 ns, R^2: 0.9998
  mean:   7.6589 ns, std dev: 0.0211 ns
  median: 7.6595 ns, MAD: 0.0152 ns

Memory Allocation Profile:
  total_allocations:     0 calls
  total_deallocations:   0 calls
  peak_heap_bytes:       0 B
  cache_lines_used:      25 lines (64 B each)
  L1D_cache_residency:   100.0%

Property Verification Suite:
  proptest::test_feature_bounds:
    runs: 10,000 / 10,000 passed (1.42s)
    shrunk_counterexamples: 0
    panics_encountered: 0</code></pre>

                  <div class="pt-2 border-t border-border/30 text-muted-foreground text-[11px] space-y-1">
                    <div class="flex items-center justify-between">
                      <span class="text-foreground font-medium">Confidence Interval:</span>
                      <span class="text-emerald-500 font-semibold">95.0% bootstrap</span>
                    </div>
                    <div class="flex items-center justify-between">
                      <span class="text-foreground font-medium">Compiler Optimization:</span>
                      <span class="text-emerald-500 font-semibold">opt-level = 3, lto = "thin"</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 3-Column Capability Grid -->
      <section class="max-w-6xl mx-auto px-6 py-20 border-t border-border/30">
        <div class="grid gap-8 md:grid-cols-3">
          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[7.66 NS P99]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">hot-path throughput</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Delivers 3.8x faster execution than heap vectors by eliminating malloc and free syscalls on the critical packet inspection and feature evaluation path.
            </p>
          </article>

          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[0 BYTES HEAP]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">zero heap reallocations</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Guarantees fixed stack layout and prevents heap memory fragmentation, ensuring edge proxies never succumb to memory exhaustion under traffic spikes.
            </p>
          </article>

          <article class="rounded-xl border border-border/40 bg-card/20 p-6 space-y-3">
            <span class="text-[11px] font-mono text-muted-foreground">[10,000 PROPTEST]</span>
            <h3 class="text-lg font-semibold text-foreground leading-snug lowercase font-sans">exhaustive edge fuzzing</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
              Sweeps 10,000 randomized permutations with adversarial duplicate keys, descending ranks, and empty sets to mathematically prove invariant safety.
            </p>
          </article>
        </div>
      </section>

      <FinalCTA />
    </main>

    <Footer />
  </div>
</BaseLayout>
