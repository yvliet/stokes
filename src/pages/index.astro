---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import StudioSpotlight from '../components/StudioSpotlight.astro';
import CliTerminal from '../components/CliTerminal.astro';
import BenchmarkGrid from '../components/BenchmarkGrid.astro';
import OutageCaseStudy from '../components/OutageCaseStudy.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="stokes | visual storage pipeline studio & cross-compiler verification"
  description="Visual storage pipeline studio and autonomous cross-compiler code synthesis for SQL, Python, and Rust. Eliminate multi-tier runtime panics before code commits."
>
  <div class="flex min-h-screen flex-col bg-background text-foreground transition-colors selection:bg-neutral-200 dark:selection:bg-neutral-800">
    <Navbar />
    
    <main class="flex-1">
      <Hero />
      <StudioSpotlight />
      <CliTerminal />
      <BenchmarkGrid />
      <OutageCaseStudy />
      <FAQ />
      <FinalCTA />
    </main>

    <Footer />
  </div>
</BaseLayout>
