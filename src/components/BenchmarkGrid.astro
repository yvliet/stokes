---
---

<section id="benchmarks" class="px-6 py-16 border-t border-border/30">
  <div class="max-w-5xl mx-auto space-y-8">
    
    <!-- Section Header -->
    <div class="text-left space-y-2">
      <p class="text-sm text-muted-foreground font-mono">benchmarks</p>
      <h2 class="text-3xl font-extralight tracking-tight sm:text-4xl text-foreground lowercase">
        fits entirely in l1 cache.
      </h2>
      <p class="text-base text-muted-foreground font-light max-w-2xl lowercase">
        the hot path does partial selection in-place on a fixed stack buffer. no heap allocations, no latency spikes, all 200 feature descriptors in 25 cache lines.
      </p>
    </div>

    <!-- Performance Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      
      <!-- Chart Card (7 cols) -->
      <div class="lg:col-span-7 rounded-xl border border-border/50 bg-card/40 stokes-card backdrop-blur-sm p-5 sm:p-6 flex flex-col justify-between space-y-6">
        <div>
          <div class="flex items-center justify-between text-xs font-mono mb-1">
            <span class="text-foreground font-medium lowercase">criterion micro-benchmark: hot-path P99 latency</span>
            <span class="text-muted-foreground/50">10k iterations · plotters</span>
          </div>
          <p class="text-xs text-muted-foreground font-light lowercase">
            lower is better. nanoseconds per packet feature partition.
          </p>
        </div>

        <!-- Latency Bar Visualization -->
        <div class="space-y-4 font-mono text-xs">
          <!-- Item 1: Stokes -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-emerald-500 font-semibold">stokes dual-zone (in-place)</span>
              <span class="text-emerald-500 font-bold">7.66 ns</span>
            </div>
            <div class="h-3 w-full bg-muted/40 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500 rounded-full" style="width: 11%;"></div>
            </div>
          </div>

          <!-- Item 2: Heap Vector -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-muted-foreground">heap vector (Vec::with_capacity)</span>
              <span class="text-muted-foreground">29.74 ns</span>
            </div>
            <div class="h-3 w-full bg-muted/40 rounded-full overflow-hidden">
              <div class="h-full bg-muted-foreground/40 rounded-full" style="width: 43%;"></div>
            </div>
          </div>

          <!-- Item 3: Std Quicksort -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-muted-foreground">std quicksort (slice::sort_unstable)</span>
              <span class="text-muted-foreground">42.10 ns</span>
            </div>
            <div class="h-3 w-full bg-muted/40 rounded-full overflow-hidden">
              <div class="h-full bg-muted-foreground/30 rounded-full" style="width: 61%;"></div>
            </div>
          </div>

          <!-- Item 4: Dynamic Realloc -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-[11px]">
              <span class="text-muted-foreground/70">dynamic realloc (naive vector expansion)</span>
              <span class="text-muted-foreground/70">68.50 ns</span>
            </div>
            <div class="h-3 w-full bg-muted/40 rounded-full overflow-hidden">
              <div class="h-full bg-muted-foreground/20 rounded-full" style="width: 100%;"></div>
            </div>
          </div>
        </div>

        <!-- Summary Metric -->
        <div class="pt-4 border-t border-border/30 flex items-center justify-between text-xs font-mono">
          <span class="text-muted-foreground lowercase">stokes throughput:</span>
          <span class="text-emerald-500 font-semibold">130.5M features/sec</span>
        </div>
      </div>

      <!-- Comparison Matrix Card (5 cols) -->
      <div class="lg:col-span-5 rounded-xl border border-border/50 bg-card/40 stokes-card backdrop-blur-sm p-5 sm:p-6 flex flex-col justify-between space-y-4">
        <div>
          <span class="text-foreground font-medium text-xs font-mono lowercase">resource profile</span>
          <p class="text-xs text-muted-foreground font-light mt-1 lowercase">
            how the hot path avoids panics when schemas grow.
          </p>
        </div>

        <div class="space-y-3 font-mono text-xs">
          <div class="p-2.5 rounded-lg border border-border/30 bg-background/50 space-y-1">
            <div class="text-[11px] text-muted-foreground lowercase tracking-wider">memory allocation</div>
            <div class="flex items-center justify-between">
              <span class="text-foreground lowercase">heap allocation</span>
              <span class="text-emerald-500 font-bold lowercase">0 bytes</span>
            </div>
          </div>

          <div class="p-2.5 rounded-lg border border-border/30 bg-background/50 space-y-1">
            <div class="text-[11px] text-muted-foreground lowercase tracking-wider">cpu cache footprint</div>
            <div class="flex items-center justify-between">
              <span class="text-foreground lowercase">200 descriptors</span>
              <span class="text-emerald-500 font-bold lowercase">25 L1 lines (1,600 b)</span>
            </div>
          </div>

          <div class="p-2.5 rounded-lg border border-border/30 bg-background/50 space-y-1">
            <div class="text-[11px] text-muted-foreground lowercase tracking-wider">algorithmic complexity</div>
            <div class="flex items-center justify-between">
              <span class="text-foreground lowercase">partial quickselect</span>
              <span class="text-foreground font-bold lowercase">O(N) expected</span>
            </div>
          </div>

          <div class="p-2.5 rounded-lg border border-border/30 bg-background/50 space-y-1">
            <div class="text-[11px] text-muted-foreground lowercase tracking-wider">property fuzzing battery</div>
            <div class="flex items-center justify-between">
              <span class="text-foreground lowercase">proptest cases</span>
              <span class="text-emerald-500 font-bold lowercase">10,000 / 10,000 pass</span>
            </div>
          </div>
        </div>

        <div class="pt-3 border-t border-border/30 text-[11px] text-muted-foreground font-mono lowercase">
          tested on AMD EPYC 7763 & Apple M3 Max
        </div>
      </div>

    </div>

  </div>
</section>
