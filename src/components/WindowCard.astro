---
interface Props {
  title: string;
  badge?: string;
  class?: string;
}

const { title, badge, class: className = "" } = Astro.props;
---

<div class={`mac-window rounded-2xl border border-neutral-200 dark:border-[#3a3a3a] bg-white dark:bg-[#2a2a2a] shadow-xs overflow-hidden transition-all ${className}`}>
  <!-- macOS Title Bar -->
  <div class="flex items-center justify-between px-4 py-2.5 border-b border-neutral-200/80 dark:border-[#3a3a3a] bg-neutral-50/70 dark:bg-[#1e1e1e] select-none">
    <div class="flex items-center space-x-2">
      <!-- 3 macOS Traffic Light Dots -->
      <div class="flex items-center space-x-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56] opacity-90"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e] opacity-90"></span>
        <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f] opacity-90"></span>
      </div>
      <!-- Monospace Title -->
      <span class="font-mono text-xs text-neutral-600 dark:text-neutral-400 font-normal pl-2">{title}</span>
    </div>

    {badge && (
      <span class="font-mono text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-full bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400 border border-neutral-200/60 dark:border-neutral-700/60">
        {badge}
      </span>
    )}
  </div>

  <!-- Window Content Body -->
  <div class="p-4 sm:p-5 text-sm font-mono leading-relaxed overflow-x-auto text-neutral-800 dark:text-neutral-200">
    <slot />
  </div>
</div>
