---
---

<footer class="border-t border-border/40 bg-background/50">
  <div class="px-6 flex flex-col gap-10 py-12 max-w-7xl mx-auto">
    
    <!-- 4-Column Focused Grid: Brand + Commands + Overview + Resources -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Column 1: Brand Info -->
      <div class="col-span-2 sm:col-span-2 lg:col-span-1 flex flex-col gap-4">
        <a href="/" class="flex items-center gap-2.5 text-foreground no-underline group">
          <svg width="18" height="18" viewBox="0 0 1024 1024" fill="none" class="shrink-0 text-foreground" style="display: block;">
            <path d="M92 108H307V216H200V806H307V914H92V108ZM930 108H715V216H822V806H715V914H930V108Z" fill="currentColor"/>
          </svg>
          <span class="font-mystandard text-base font-normal lowercase">stokes</span>
        </a>
        <p class="text-xs text-muted-foreground leading-relaxed lowercase">
          visual storage pipeline studio & autonomous cross-compiler code synthesis for sql, python, and rust.
        </p>
        <p class="text-xs text-muted-foreground mt-auto lowercase">
          © 2026 yvliet. released under the mit license.
        </p>
      </div>

      <!-- Column 2: Studio & CLI Commands -->
      <div class="col-span-1 flex flex-col gap-3">
        <span class="font-medium text-foreground text-sm lowercase">studio & cli</span>
        <div class="flex flex-col gap-2 text-xs">
          <a href="/studio" class="text-muted-foreground hover:text-foreground transition-colors font-medium lowercase">launch studio</a>
          <a href="/#terminal" data-terminal-tab="tab-scan" class="text-muted-foreground hover:text-foreground transition-colors cursor-pointer lowercase">stokes scan</a>
          <a href="/#terminal" data-terminal-tab="tab-audit" class="text-muted-foreground hover:text-foreground transition-colors cursor-pointer lowercase">stokes audit</a>
          <a href="/#terminal" data-terminal-tab="tab-bench" class="text-muted-foreground hover:text-foreground transition-colors cursor-pointer lowercase">stokes bench</a>
          <a href="/#terminal" data-terminal-tab="tab-cert" class="text-muted-foreground hover:text-foreground transition-colors cursor-pointer lowercase">stokes cert</a>
        </div>
      </div>

      <!-- Column 3: Overview (Page Content Sections) -->
      <div class="col-span-1 flex flex-col gap-3">
        <span class="font-medium text-foreground text-sm lowercase">overview</span>
        <div class="flex flex-col gap-2 text-xs">
          <a href="/studio" class="text-muted-foreground hover:text-foreground transition-colors font-medium lowercase">studio canvas</a>
          <a href="/#studio-spotlight" class="text-muted-foreground hover:text-foreground transition-colors lowercase">studio overview</a>
          <a href="/#terminal" class="text-muted-foreground hover:text-foreground transition-colors lowercase">terminal</a>
          <a href="/#benchmarks" class="text-muted-foreground hover:text-foreground transition-colors lowercase">benchmarks</a>
          <a href="/#outage-tour" class="text-muted-foreground hover:text-foreground transition-colors lowercase">case study</a>
          <a href="/#faq" class="text-muted-foreground hover:text-foreground transition-colors lowercase">faq</a>
        </div>
      </div>

      <!-- Column 4: Resources -->
      <div class="col-span-1 flex flex-col gap-3">
        <span class="font-medium text-foreground text-sm lowercase">resources</span>
        <div class="flex flex-col gap-2 text-xs">
          <a href="/docs" class="text-muted-foreground hover:text-foreground transition-colors lowercase">docs</a>
          <a href="https://github.com/yvliet/stokes" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors lowercase">github repository</a>
          <a href="https://github.com/yvliet/dirichlet" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors lowercase">dirichlet benchmark</a>
          <a href="https://github.com/yvliet/stokes/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors lowercase">mit license</a>
        </div>
      </div>

    </div>

    <!-- Bottom Action & Social Bar -->
    <div class="flex flex-col gap-4 pt-6 border-t border-border/40 sm:flex-row sm:justify-between sm:items-center">
      <!-- Social Icon Buttons -->
      <div class="flex items-center gap-2">
        <a 
          href="https://github.com/yvliet/stokes" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="GitHub"
          class="h-8 w-8 flex items-center justify-center rounded-lg border border-transparent hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
        </a>

        <a 
          href="https://x.com/yvliet" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="X / Twitter"
          class="h-8 w-8 flex items-center justify-center rounded-lg border border-transparent hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
          </svg>
        </a>
      </div>

      <!-- Runtime & Engine Attribution Badge -->
      <div class="flex items-center gap-2">
        <div class="inline-flex items-center gap-2 rounded-full border border-border/60 bg-card/60 px-3 py-1 text-xs text-muted-foreground">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="lowercase">v0.1.0-alpha</span>
          <span class="text-border">|</span>
          <span class="lowercase">built on ibm bob 2.0 shell</span>
        </div>
      </div>
    </div>

  </div>
</footer>
