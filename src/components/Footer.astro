---
---

<footer class="border-t border-border/40 bg-background/50">
  <div class="px-6 flex flex-col gap-10 py-12 max-w-7xl mx-auto">
    
    <!-- 4-Column Focused Grid: Brand + Commands + Overview + Resources -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Column 1: Brand Info -->
      <div class="col-span-2 sm:col-span-2 lg:col-span-1 flex flex-col gap-4">
        <a href="/" class="flex items-center gap-2.5 text-foreground no-underline group">
          <svg width="18" height="18" viewBox="0 0 1024 1024" fill="none" class="shrink-0 text-foreground" style="display: block;">
            <path d="M92 108H307V216H200V806H307V914H92V108ZM930 108H715V216H822V806H715V914H930V108Z" fill="currentColor"/>
          </svg>
          <span class="font-mystandard text-base font-normal">stokes</span>
        </a>
        <p class="text-xs text-muted-foreground leading-relaxed">
          cross-language verification cli. catches the bugs your individual compilers miss.
        </p>
        <p class="text-xs text-muted-foreground mt-auto">
          © 2026 yvliet. Released under the MIT License.
        </p>
      </div>

      <!-- Column 2: CLI Commands (Clicking activates the terminal tab) -->
      <div class="col-span-1 flex flex-col gap-3">
        <span class="font-medium text-foreground text-sm">commands</span>
        <div class="flex flex-col gap-2 text-xs">
          <a href="#terminal" data-terminal-tab="tab-scan" class="text-muted-foreground hover:text-foreground transition-colors cursor-pointer">stokes scan</a>
          <a href="#terminal" data-terminal-tab="tab-audit" class="text-muted-foreground hover:text-foreground transition-colors cursor-pointer">stokes audit</a>
          <a href="#terminal" data-terminal-tab="tab-bench" class="text-muted-foreground hover:text-foreground transition-colors cursor-pointer">stokes bench</a>
          <a href="#terminal" data-terminal-tab="tab-cert" class="text-muted-foreground hover:text-foreground transition-colors cursor-pointer">stokes cert</a>
        </div>
      </div>

      <!-- Column 3: Overview (Page Content Sections) -->
      <div class="col-span-1 flex flex-col gap-3">
        <span class="font-medium text-foreground text-sm">overview</span>
        <div class="flex flex-col gap-2 text-xs">
          <a href="#terminal" class="text-muted-foreground hover:text-foreground transition-colors">terminal</a>
          <a href="#benchmarks" class="text-muted-foreground hover:text-foreground transition-colors">benchmarks</a>
          <a href="#outage-tour" class="text-muted-foreground hover:text-foreground transition-colors">case study</a>
          <a href="#faq" class="text-muted-foreground hover:text-foreground transition-colors">faq</a>
        </div>
      </div>

      <!-- Column 4: Resources -->
      <div class="col-span-1 flex flex-col gap-3">
        <span class="font-medium text-foreground text-sm">resources</span>
        <div class="flex flex-col gap-2 text-xs">
          <a href="https://github.com/yvliet/stokes#readme" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">docs</a>
          <a href="https://github.com/yvliet/stokes" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">github repository</a>
          <a href="https://github.com/yvliet/dirichlet" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">dirichlet benchmark</a>
          <a href="https://github.com/yvliet/stokes/blob/main/LICENSE" target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors">mit license</a>
        </div>
      </div>

    </div>

    <!-- Bottom Action & Social Bar (exact inference.sh bottom bar) -->
    <div class="flex flex-col gap-4 pt-6 border-t border-border/40 sm:flex-row sm:justify-between sm:items-center">
      <!-- Social Icon Buttons -->
      <div class="flex items-center gap-2">
        <a 
          href="https://github.com/yvliet/stokes" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="GitHub"
          class="h-8 w-8 flex items-center justify-center rounded-lg border border-transparent hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
          </svg>
        </a>

        <a 
          href="https://x.com/yvliet" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="X / Twitter"
          class="h-8 w-8 flex items-center justify-center rounded-lg border border-transparent hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path>
          </svg>
        </a>

        <a 
          href="https://discord.gg/inference" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Discord"
          class="h-8 w-8 flex items-center justify-center rounded-lg border border-transparent hover:bg-muted text-muted-foreground hover:text-foreground transition-colors"
        >
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 256 199" aria-hidden="true">
            <path d="M216.856 16.597A208.502 208.502 0 0 0 164.042 0c-2.275 4.113-4.933 9.645-6.766 14.046-19.692-2.961-39.203-2.961-58.533 0-1.832-4.4-4.55-9.933-6.846-14.046a207.809 207.809 0 0 0-52.855 16.638C5.618 67.147-3.443 116.4 1.087 164.956c22.169 16.555 43.653 26.612 64.775 33.193A161.094 161.094 0 0 0 79.735 175.3a136.413 136.413 0 0 1-21.846-10.632 108.636 108.636 0 0 0 5.356-4.237c42.122 19.702 87.89 19.702 129.51 0a131.66 131.66 0 0 0 5.355 4.237 136.07 136.07 0 0 1-21.886 10.653c4.006 8.02 8.638 15.67 13.873 22.848 21.142-6.58 42.646-16.637 64.815-33.213 5.316-56.288-9.08-105.09-38.056-148.36ZM85.474 135.095c-12.645 0-23.015-11.805-23.015-26.18s10.149-26.2 23.015-26.2c12.867 0 23.236 11.804 23.015 26.2.02 14.375-10.148 26.18-23.015 26.18Zm85.051 0c-12.645 0-23.014-11.805-23.014-26.18s10.148-26.2 23.014-26.2c12.867 0 23.236 11.804 23.015 26.2 0 14.375-10.148 26.18-23.015 26.18Z"></path>
          </svg>
        </a>
      </div>

      <!-- Runtime & Engine Attribution Badge -->
      <div class="flex items-center gap-2">
        <div class="inline-flex items-center gap-2 rounded-full border border-border/60 bg-card/60 px-3 py-1 text-xs text-muted-foreground">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>v0.1.0-alpha</span>
          <span class="text-border">|</span>
          <span>Built on IBM Bob 2.0</span>
        </div>
      </div>
    </div>

  </div>
</footer>
