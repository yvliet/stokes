---
import IntegrationsMarquee from './IntegrationsMarquee.astro';
---

<section class="min-h-[calc(100vh-4rem)] flex flex-col justify-between pt-12 sm:pt-16 pb-8 sm:pb-12 px-6 text-center relative">
  <div class="container mx-auto max-w-7xl flex-1 flex flex-col justify-center">
    
    <!-- Centered Logo (Matrix Brackets in Sentient Font) -->
    <div class="mb-5 flex items-center justify-center select-none" aria-label="stokes logo">
      <span class="font-serif text-3xl sm:text-4xl text-foreground font-light leading-none inline-flex items-center justify-center gap-2">
        <span>[</span>
        <span>]</span>
      </span>
    </div>

    <!-- Primary Headline (1-2 lines) -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl mb-4 leading-[1.08] tracking-tight text-foreground max-w-5xl mx-auto lowercase">
      every compiler passed. production still panicked.
    </h1>

    <!-- Subtitle (strictly 2 lines on desktop) -->
    <p class="text-base sm:text-lg text-muted-foreground max-w-4xl mx-auto mb-6 font-light leading-relaxed lowercase">
      statically enforces schema contracts across clickhouse sql, python pipelines, and rust edge proxies.<br class="hidden md:inline" /> runs in under 38ms in ci with native mcp discovery for cursor and claude code.
    </p>

    <!-- Instant Copyable Install Command -->
    <div class="flex flex-col items-center justify-center mb-6">
      <div class="inline-flex items-center gap-3 rounded-full border border-border/80 bg-card/60 px-4 py-2 font-mono text-xs sm:text-sm text-foreground shadow-sm hover:border-foreground/30 transition-colors">
        <span class="text-emerald-500 font-semibold select-none">$</span>
        <code id="install-cmd" class="select-all font-mono">curl -fsSL https://stokes.dev/install.sh | sh</code>
        <button 
          id="copy-btn"
          type="button"
          class="ml-1 inline-flex items-center justify-center rounded p-1.5 text-muted-foreground hover:text-foreground transition-colors cursor-pointer"
          aria-label="Copy install command"
        >
          <svg id="copy-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <svg id="check-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden text-emerald-500">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Action CTAs -->
    <div class="flex flex-col sm:flex-row gap-3.5 justify-center items-center mb-6">
      <a 
        href="#terminal" 
        class="group/button inline-flex shrink-0 items-center justify-center gap-2 border border-transparent font-medium whitespace-nowrap outline-none select-none h-11 px-7 text-base bg-foreground text-background hover:bg-foreground/90 transition-all rounded-full cursor-pointer shadow-xs"
      >
        <span class="lowercase">explore cli</span>
        <span>↓</span>
      </a>
      <a 
        href="/docs" 
        class="group/button inline-flex shrink-0 items-center justify-center border border-border bg-card/60 text-foreground hover:bg-muted transition-all select-none h-11 px-7 text-base rounded-full cursor-pointer"
      >
        <span class="lowercase">read documentation</span>
        <span class="ml-1 text-muted-foreground">→</span>
      </a>
    </div>
  </div>

  <!-- Integrations Marquee -->
  <div class="container mx-auto max-w-7xl pt-4">
    <p class="text-[11px] font-sans font-medium tracking-[0.2em] lowercase text-muted-foreground/60 mb-4 select-none">
      deterministic ci contract gate &amp; native mcp bridge for coding agents
    </p>
    <IntegrationsMarquee />
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-btn');
  const copyIcon = document.getElementById('copy-icon');
  const checkIcon = document.getElementById('check-icon');
  const installCmd = document.getElementById('install-cmd');

  if (copyBtn && installCmd) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(installCmd.innerText);
        if (copyIcon && checkIcon) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy command:', err);
      }
    });
  }
</script>
