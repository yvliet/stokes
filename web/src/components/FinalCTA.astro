<section class="border-t border-border/30">
  <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-8 px-6 py-24 md:flex-row md:items-end">
    <div>
      <h2 class="text-5xl font-extralight tracking-tight sm:text-6xl text-foreground">
        ready to verify?
      </h2>
      <p class="mt-5 text-lg text-muted-foreground font-light max-w-xl">
        install the cli, point it at your repo, and add `stokes verify` to your ci pipeline. takes about two minutes.
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
      <a 
        href="https://github.com/yvliet/stokes" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center justify-center border border-transparent font-medium whitespace-nowrap h-12 px-8 text-lg bg-foreground text-background hover:bg-foreground/90 transition-all rounded-full cursor-pointer"
      >
        install cli
      </a>
      <a 
        href="https://github.com/yvliet/stokes" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex shrink-0 items-center justify-center border border-transparent font-medium whitespace-nowrap hover:bg-muted hover:text-foreground transition-all h-12 px-8 text-lg rounded-full cursor-pointer text-muted-foreground"
      >
        view on github
      </a>
    </div>
