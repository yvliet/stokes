<section id="terminal" class="px-6 py-16 scroll-mt-16">
  <div class="max-w-5xl mx-auto space-y-6">
    
    <!-- Section Header -->
    <div class="text-left space-y-2">
      <p class="text-sm text-muted-foreground font-mono lowercase">terminal</p>
      <h2 class="text-3xl font-extralight tracking-tight sm:text-4xl text-foreground lowercase">
        cli-first contract engine. native mcp bridge.
      </h2>
      <p class="text-base text-muted-foreground font-light max-w-3xl lowercase">
        run stokes verify in ci for deterministic sub-50ms boundary contract verification.<br class="hidden md:inline" /> attach stokes mcp to feed verified cross-boundary schemas directly to coding agents.
      </p>
      <div class="pt-2 flex flex-wrap items-center gap-6">
        <a 
          href="/cli" 
          class="text-sm text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1 lowercase"
        >
          view cli documentation <span>→</span>
        </a>
        <a 
          href="/analyzers" 
          class="text-sm text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1 lowercase"
        >
          view language analyzers <span>→</span>
        </a>
      </div>
    </div>

    <!-- Terminal Window Container (macOS terminal styling) -->
    <div class="rounded-xl border border-border/50 bg-card/40 stokes-card overflow-hidden backdrop-blur-sm">
      
      <!-- Window Titlebar with Command Tabs -->
      <div class="flex flex-wrap items-center justify-between border-b border-border/40 bg-muted/30 px-4 py-2.5 gap-2">
        <!-- Window Traffic Dots & Invariant Specs -->
        <div class="flex items-center gap-2 shrink-0 font-mono">
          <div class="flex items-center gap-1.5">
            <span class="h-2.5 w-2.5 rounded-full bg-red-500/50"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/50"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-green-500/50"></span>
          </div>
          <span class="text-xs text-muted-foreground/60 ml-1.5 hidden sm:inline">stokes v0.2.0</span>
          <span class="text-muted-foreground/30 hidden md:inline">·</span>
          <span class="text-[11px] text-muted-foreground/70 hidden md:inline">semantic ast hashing · 3 boundaries · sha-256</span>
        </div>

        <!-- Command Switcher Tabs -->
        <div class="flex items-center gap-1 font-mono text-xs overflow-x-auto">
          <button 
            type="button" 
            class="tab-btn px-3 py-1 rounded-md transition-all font-medium cursor-pointer bg-foreground/10 text-foreground"
            data-target="tab-scan"
          >
            stokes mcp
          </button>
          <button 
            type="button" 
            class="tab-btn px-3 py-1 rounded-md transition-all font-medium cursor-pointer text-muted-foreground hover:text-foreground hover:bg-foreground/5"
            data-target="tab-audit"
          >
            agent audit
          </button>
          <button 
            type="button" 
            class="tab-btn px-3 py-1 rounded-md transition-all font-medium cursor-pointer text-muted-foreground hover:text-foreground hover:bg-foreground/5"
            data-target="tab-bench"
          >
            stokes verify
          </button>
          <button 
            type="button" 
            class="tab-btn px-3 py-1 rounded-md transition-all font-medium cursor-pointer text-muted-foreground hover:text-foreground hover:bg-foreground/5"
            data-target="tab-codegen"
          >
            stokes codegen
          </button>
          <button 
            type="button" 
            class="tab-btn px-3 py-1 rounded-md transition-all font-medium cursor-pointer text-muted-foreground hover:text-foreground hover:bg-foreground/5"
            data-target="tab-cert"
          >
            stokes cert
          </button>
        </div>
      </div>

      <!-- Terminal Body Content (Fixed Height across all command tabs) -->
      <div class="p-4 sm:p-6 font-mono text-xs sm:text-[13px] leading-normal tracking-normal bg-background/90 h-[410px] sm:h-[380px] overflow-y-auto">
        
        <!-- ================= TAB 1: MCP SERVER ================= -->
        <div id="tab-scan" class="tab-content space-y-3">
          <div class="flex items-center gap-2 text-foreground font-medium pb-2 border-b border-border/30">
            <span class="text-emerald-500 select-none">$</span>
            <span>stokes mcp --stdio</span>
            <span class="text-muted-foreground/40 ml-auto text-xs hidden sm:inline">json-rpc 2.0 · 38ms discovery</span>
          </div>

          <!-- Stokes Header Banner: 3x3 mathematical matrix bracket -->
          <div class="space-y-0 text-xs text-muted-foreground font-mono leading-snug">
            <!-- Row 1: ⎡ · ■ · ⎤ -->
            <div class="flex items-center gap-3">
              <span class="shrink-0 select-none whitespace-pre text-foreground"><span>⎡</span> <span class="text-muted-foreground/40">·</span>  <span class="text-foreground">■</span>  <span class="text-muted-foreground/40">·</span> <span>⎤</span></span>
              <span class="truncate"><span class="text-foreground font-semibold">stokes-mcp v0.2.0</span> <span class="text-muted-foreground/60">·</span> protocolVersion: 2024-11-05</span>
            </div>
            <!-- Row 2: ⎢ ■ ■ · ⎥ -->
            <div class="flex items-center gap-3">
              <span class="shrink-0 select-none whitespace-pre text-foreground"><span>⎢</span> <span class="text-foreground">■</span>  <span class="text-foreground">■</span>  <span class="text-muted-foreground/40">·</span> <span>⎥</span></span>
              <span class="truncate"><span class="text-muted-foreground">connected clients:</span> <span class="text-foreground">claude-code · ibm-bob-2.0 · cursor · windsurf</span></span>
            </div>
            <!-- Row 3: ⎣ · · ■ ⎦ -->
            <div class="flex items-center gap-3">
              <span class="shrink-0 select-none whitespace-pre text-foreground"><span>⎣</span> <span class="text-muted-foreground/40">·</span>  <span class="text-muted-foreground/40">·</span>  <span class="text-foreground">■</span> <span>⎦</span></span>
              <span class="truncate"><span class="text-muted-foreground">resources: stokes://contracts · stokes://lockfile · stokes://diagnostics</span></span>
            </div>
          </div>

          <!-- Execution Log: scanner header + tree-nested analyzer threads -->
          <div class="space-y-1 pt-1 text-muted-foreground font-mono">
            <div class="flex items-baseline gap-1.5">
              <span class="px-1.5 py-0.5 rounded bg-muted/80 text-foreground text-[10px] font-bold">MCP</span>
              <span class="text-foreground font-medium">Stdio server initialized with capabilities:</span>
            </div>
            <div class="space-y-0.5 pl-0">
              <div class="flex items-center gap-1">
                <span class="text-muted-foreground/60 select-none">├──</span>
                <span class="text-foreground font-medium w-[13ch] shrink-0">tools</span>
                <span class="text-muted-foreground/60">›</span>
                <span class="text-muted-foreground truncate">stokes_scan, stokes_audit, stokes_verify_patch, stokes_cert</span>
              </div>
              <div class="flex items-center gap-1">
                <span class="text-muted-foreground/60 select-none">├──</span>
                <span class="text-foreground font-medium w-[13ch] shrink-0">resources</span>
                <span class="text-muted-foreground/60">›</span>
                <span class="text-muted-foreground truncate">stokes://contracts (live ClickHouse ↔ Python ↔ Rust boundary map)</span>
              </div>
              <div class="flex items-center gap-1">
                <span class="text-muted-foreground/60 select-none">└──</span>
                <span class="text-foreground font-medium w-[13ch] shrink-0">prompts</span>
                <span class="text-muted-foreground/60">›</span>
                <span class="text-muted-foreground truncate">stokes_refactor_contract, stokes_explain_violation</span>
              </div>
            </div>
          </div>

          <!-- Completion Badge -->
          <div class="mt-4 rounded border border-emerald-500/20 bg-emerald-500/5 px-3 py-2 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-1 text-xs">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500 shrink-0"></span>
              <span class="text-foreground font-medium">mcp substrate active: listening on stdio (38ms discovery)</span>
            </div>
            <span class="text-emerald-600 dark:text-emerald-400 font-mono text-[11px]">stokes://contracts ready</span>
          </div>
        </div>

        <!-- ================= TAB 2: AGENT AUDIT ================= -->
        <div id="tab-audit" class="tab-content hidden space-y-3">
          <div class="flex items-center gap-2 text-foreground font-medium pb-2 border-b border-border/30">
            <span class="text-emerald-500 select-none">$</span>
            <span>Claude Code (MCP) › call: stokes_audit &#123;&quot;target&quot;: &quot;clickhouse/events_r0&quot;&#125;</span>
            <span class="text-muted-foreground/40 ml-auto text-xs hidden sm:inline">mcp tool call · 84ms</span>
          </div>

          <div class="space-y-1.5 text-muted-foreground">
            <div class="flex items-center gap-2">
              <span class="text-amber-500 font-bold">▲</span>
              <span class="text-amber-600 dark:text-amber-400 font-medium">[stokes-sql]</span>
              <span class="text-foreground">ClickHouse migration expands replica projection to 280 columns</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-rose-500 font-bold">✗</span>
              <span class="text-rose-600 dark:text-rose-400 font-medium">[stokes-rust]</span>
              <span class="text-rose-600 dark:text-rose-400">LINT-004 FATAL: input length 280 exceeds buffer [Feature; 200] in buffer.rs:42</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span class="text-foreground/80">[stokes-mcp]</span>
              <span>suggesting defensive bounds validation patch (Result&lt;_, ContractError&gt;)</span>
            </div>
          </div>

          <!-- Interactive Patch Proposal -->
          <div class="mt-3 rounded border border-amber-500/30 bg-amber-500/5 p-3 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="font-medium text-amber-600 dark:text-amber-400">suggested fix: crates/dirichlet-proxy/src/buffer.rs</span>
              <span class="text-[11px] text-emerald-600 dark:text-emerald-400 font-mono">zero-panic verified</span>
            </div>
            <div class="text-xs text-muted-foreground font-mono font-light bg-background/60 p-2 rounded border border-border/30">
              <p class="text-emerald-600 dark:text-emerald-400">+ if payload.len() &gt; 200 &#123; return Err(ContractError::CapacityExceeded &#123; received: payload.len(), max: 200 &#125;); &#125;</p>
              <p class="text-emerald-600 dark:text-emerald-400">+ let features: [Feature; 200] = payload[..200].try_into().map_err(|_| ContractError::Invalid)?;</p>
            </div>
            <div class="flex items-center gap-2 pt-1 font-sans">
              <span class="text-xs px-2.5 py-1 rounded bg-foreground text-background font-medium lowercase">
                apply defensive bounds patch
              </span>
              <span class="text-xs text-emerald-600 dark:text-emerald-400 font-mono">
                verified via stokes_verify_patch · 0 unhandled panics
              </span>
            </div>
          </div>
        </div>

        <!-- ================= TAB 3: VERIFY ================= -->
        <div id="tab-bench" class="tab-content hidden space-y-3">
          <div class="flex items-center gap-2 text-foreground font-medium pb-2 border-b border-border/30">
            <span class="text-emerald-500 select-none">$</span>
            <span>stokes verify --cases 10000</span>
            <span class="text-muted-foreground/40 ml-auto text-xs hidden sm:inline">adversarial property fuzzing</span>
          </div>

          <div class="space-y-1.5 text-muted-foreground">
            <div>running IEEE-754 float sanitization &amp; bounds verification battery...</div>
            <div class="text-foreground font-medium pt-1">property fuzzing 10,000 randomized cross-service payloads:</div>
            <div class="pl-4 text-emerald-600 dark:text-emerald-400">
              verification: <span class="font-bold">PASSED (10,000 / 10,000 cases in 1.34s)</span>
            </div>
            <div class="pl-4 text-muted-foreground">
              adversarial tests: <span class="text-foreground">NaN, Inf, -Inf, subnormal float32 sanitized to fail-secure</span>
            </div>
            <div class="pl-4 text-muted-foreground">
              buffer integrity:  <span class="text-emerald-600 dark:text-emerald-400 font-bold">0 panics</span> (overflow inputs rejected cleanly via Result&lt;_, Error&gt;)
            </div>

            <div class="text-foreground font-medium pt-2">hot-path memory profile:</div>
            <div class="pl-4 text-foreground">
              allocation: <span class="text-emerald-600 dark:text-emerald-400 font-bold">0 bytes</span> heap reallocation on valid packets (fits inside 32 KB L1D cache)
            </div>
          </div>

          <div class="mt-4 rounded border border-emerald-500/20 bg-emerald-500/5 px-3 py-2 flex items-center justify-between text-xs">
            <span class="text-foreground font-medium lowercase">resilience verified across 10,000 adversarial payloads</span>
            <span class="text-emerald-600 dark:text-emerald-400 font-bold font-mono lowercase">0 panics · pass</span>
          </div>
        </div>

        <!-- ================= TAB 4: CERT ================= -->
        <div id="tab-cert" class="tab-content hidden space-y-3">
          <div class="flex items-center gap-2 text-foreground font-medium pb-2 border-b border-border/30">
            <span class="text-emerald-500 select-none">$</span>
            <span>stokes cert --verify-ci</span>
            <span class="text-muted-foreground/40 ml-auto text-xs hidden sm:inline">normalized semantic AST gate</span>
          </div>

          <div class="space-y-1.5 text-muted-foreground">
            <div>reading lockfile: stokes.lock (normalized semantic AST digests)</div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>clickhouse/migrations/001_bot_signals.sql == sha256:8eb837c6... (normalized AST table &amp; columns)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>services/feature-pipeline/extractor.py   == sha256:4c129ab0... (normalized AST constants &amp; classes)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>crates/dirichlet-proxy/src/buffer.rs     == sha256:b9f271d4... (normalized AST buffer &amp; error enum)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>property fuzzing battery: 10,000 randomized cases passed (1.34s)</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>conformance report written: CONFORMANCE.md</span>
            </div>
          </div>

          <div class="mt-4 rounded border border-emerald-500/20 bg-emerald-500/5 px-3 py-2 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              <span class="text-foreground font-medium">4/4 boundary checks passed</span>
            </div>
            <span class="text-emerald-600 dark:text-emerald-400 font-bold font-mono lowercase">exit code: 0</span>
          </div>
        </div>

        <!-- ================= TAB 5: CODEGEN SYNTHESIS ================= -->
        <div id="tab-codegen" class="tab-content space-y-3 hidden">
          <div class="flex items-center gap-2 text-foreground font-medium pb-2 border-b border-border/30">
            <span class="text-emerald-500 select-none">$</span>
            <span>stokes codegen --consumer crates/dirichlet-proxy/src/lib.rs --write</span>
            <span class="text-muted-foreground/40 ml-auto text-xs hidden sm:inline">synthesis · zero-heap tiered buffer</span>
          </div>

          <div class="space-y-1 font-mono text-xs">
            <div class="text-muted-foreground">[stokes-codegen] Inspecting target AST: crates/dirichlet-proxy/src/lib.rs</div>
            <div class="text-muted-foreground">[stokes-codegen] Detected unbounded slice ingestion [.try_into().unwrap()]</div>
            <div class="text-emerald-500 font-semibold">[stokes-codegen] Synthesizing certified TieredBuffer&lt;FeatureDescriptor, 200, 312&gt;</div>
            <div class="text-foreground/90 pl-3 border-l-2 border-emerald-500/40 my-2 space-y-1">
              <div class="text-emerald-400">+ use stokes_runtime::TieredBuffer;</div>
              <div class="text-emerald-400">+ let mut buffer: TieredBuffer&lt;FeatureDescriptor, 200, 312&gt; = TieredBuffer::new();</div>
              <div class="text-emerald-400">+ buffer.ingest_slice(&amp;payload)?;</div>
            </div>
            <div class="text-muted-foreground">[stokes-codegen] Applied unified patch directly to disk. 0 heap allocations, 100% data fidelity.</div>
          </div>

          <div class="mt-4 rounded border border-emerald-500/20 bg-emerald-500/5 px-3 py-2 flex items-center justify-between text-xs">
            <div class="flex items-center gap-2">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              <span class="text-foreground font-medium">safe memory layout synthesized</span>
            </div>
            <span class="text-emerald-600 dark:text-emerald-400 font-bold font-mono lowercase">status: patched</span>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>

<script>
  // Tab switching logic for terminal with global trigger support
  function switchTerminalTab(targetId: string | null) {
    if (!targetId) return;
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const tabContents = document.querySelectorAll<HTMLElement>('.tab-content');

    tabButtons.forEach(btn => {
      if (btn.getAttribute('data-target') === targetId) {
        btn.classList.remove('text-muted-foreground');
        btn.classList.add('bg-foreground/10', 'text-foreground');
      } else {
        btn.classList.remove('bg-foreground/10', 'text-foreground');
        btn.classList.add('text-muted-foreground');
      }
    });

    tabContents.forEach(content => {
      if (content.id === targetId) {
        content.classList.remove('hidden');
      } else {
        content.classList.add('hidden');
      }
    });
  }

  // Bind tab buttons
  document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      switchTerminalTab(btn.getAttribute('data-target'));
    });
  });

  // Bind external triggers (e.g. from footer links)
  document.querySelectorAll<HTMLElement>('[data-terminal-tab]').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const tabId = trigger.getAttribute('data-terminal-tab');
      switchTerminalTab(tabId);
    });
  });
</script>
