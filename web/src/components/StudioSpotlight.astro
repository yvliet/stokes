---
---

<section id="studio-spotlight" class="py-20 px-6 border-t border-border/40">
  <div class="max-w-6xl mx-auto space-y-16">
    
    <!-- Section Header (Strictly lowercase headings, no artificial pill badges) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-3 max-w-2xl text-left">
        <h2 class="text-3xl font-extralight tracking-tight sm:text-5xl text-foreground lowercase">
          figma for storage pipelines.
        </h2>
        <p class="text-base sm:text-lg text-muted-foreground font-light leading-relaxed">
          design, connect, and inspect end-to-end dataflows across clickhouse tables, python etl workers, quicksilver kv caches, and rust l7 proxies. stokes studio catches mathematical boundary overflows before they reach production.
        </p>
      </div>

      <div class="shrink-0 flex items-center gap-3">
        <a 
          href="/studio" 
          class="inline-flex items-center justify-center gap-2 h-11 px-6 rounded-full text-sm font-medium bg-foreground text-background hover:bg-foreground/90 transition-all cursor-pointer shadow-xs"
        >
          <span>open studio canvas</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Authentic Studio App Window Frame -->
    <div class="rounded-2xl border border-border/80 bg-card stokes-card overflow-hidden shadow-xs select-none">
      
      <!-- Studio Window Header -->
      <div class="flex items-center justify-between border-b border-border/50 bg-muted/40 px-4 py-2.5">
        <div class="flex items-center gap-3">
          <!-- Window Controls -->
          <div class="flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f56] opacity-80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#ffbd2e] opacity-80"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#27c93f] opacity-80"></span>
          </div>

          <!-- Document Tab -->
          <div class="flex items-center gap-2 px-2.5 py-1 rounded bg-background/80 border border-border/60 text-xs font-mono text-foreground">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
            <span>storage-topology.stk</span>
          </div>
        </div>

        <!-- Canvas Coordinates & Viewport Status -->
        <div class="hidden sm:flex items-center gap-3 font-mono text-xs text-muted-foreground">
          <span>(x: 140, y: 280)</span>
          <span class="text-border">|</span>
          <span>100%</span>
          <span class="text-border">|</span>
          <span class="text-rose-500 font-medium">1 breach detected</span>
        </div>

        <!-- Quick Studio Jump -->
        <div class="flex items-center gap-2">
          <a 
            href="/studio" 
            class="text-xs font-mono text-muted-foreground hover:text-foreground transition-colors inline-flex items-center gap-1"
          >
            <span>launch full canvas</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Studio Main Workspace: Left Tool Rail + Canvas + Right Inspector -->
      <div class="flex items-stretch min-h-[440px] bg-background/50">
        
        <!-- Left Dock Tool Rail -->
        <div class="w-11 sm:w-12 bg-muted/20 border-r border-border/40 py-3 flex flex-col items-center justify-between shrink-0">
          <div class="flex flex-col items-center gap-2">
            <!-- Select Pointer (Active) -->
            <button type="button" class="w-8 h-8 rounded flex items-center justify-center bg-foreground/10 text-foreground" title="Select (V)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 2l16 11.5-6.5 1.5 4 8-3 1.5-4-8-4.5 4.5z"/>
              </svg>
            </button>
            <!-- Hand / Pan -->
            <button type="button" class="w-8 h-8 rounded flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors" title="Pan (H)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 11V6a2 2 0 0 0-4 0v5"/>
                <path d="M14 10V4a2 2 0 0 0-4 0v7"/>
                <path d="M10 10.5V6a2 2 0 0 0-4 0v8"/>
                <path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>
              </svg>
            </button>
            <!-- Table / Schema Node -->
            <button type="button" class="w-8 h-8 rounded flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors" title="Table Node (T)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M3 9h18M3 15h18M9 3v18"/>
              </svg>
            </button>
            <!-- ETL Worker Node -->
            <button type="button" class="w-8 h-8 rounded flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors" title="Worker Function (F)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="16 18 22 12 16 6"/>
                <polyline points="8 6 2 12 8 18"/>
              </svg>
            </button>
            <!-- Fixed Buffer Sink Node -->
            <button type="button" class="w-8 h-8 rounded flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors" title="Buffer Sink (B)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
              </svg>
            </button>
            <!-- Invariant Probe Wire -->
            <button type="button" class="w-8 h-8 rounded flex items-center justify-center text-muted-foreground hover:text-foreground transition-colors" title="Invariant Probe (I)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Center Infinite Canvas with Dot Grid & Real Node Graph -->
        <div class="studio-canvas-scroll relative flex-1 p-6 sm:p-8 overflow-x-auto min-w-[560px] bg-[radial-gradient(#3a3a3a_1px,transparent_1px)] [background-size:20px_20px]">
          
          <!-- Node Graph Layout -->
          <div class="relative flex items-center justify-between gap-4 sm:gap-6 py-8">
            
            <!-- Node 1: ClickHouse DDL Table -->
            <div class="w-48 sm:w-52 rounded-lg border border-border/70 bg-card p-3.5 space-y-2.5 shadow-xs relative group">
              <div class="flex items-center justify-between font-mono text-[11px] pb-1.5 border-b border-border/40">
                <span class="text-pink-500 font-medium">events_r0.sql</span>
                <span class="text-muted-foreground/60 text-[10px]">clickhouse</span>
              </div>
              <div class="font-mono text-xs space-y-1">
                <div class="text-foreground/90 font-medium">bot_signals</div>
                <div class="text-[11px] text-muted-foreground">280 partition cols</div>
                <div class="text-[10px] text-muted-foreground/60">schema reflection</div>
              </div>
              <!-- Right Output Port Handle -->
              <div class="absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-border border-2 border-background" title="Output Port"></div>
            </div>

            <!-- Wire 1 -> 2 (Clean Bezier Wire with Flow Indicator) -->
            <div class="shrink-0 flex items-center justify-center font-mono text-xs text-muted-foreground/40">
              <span>→</span>
            </div>

            <!-- Node 2: Python ETL Pipeline -->
            <div class="w-48 sm:w-52 rounded-lg border border-border/70 bg-card p-3.5 space-y-2.5 shadow-xs relative group">
              <!-- Left Input Port Handle -->
              <div class="absolute -left-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-border border-2 border-background" title="Input Port"></div>
              
              <div class="flex items-center justify-between font-mono text-[11px] pb-1.5 border-b border-border/40">
                <span class="text-purple-500 font-medium">catalog_sync.py</span>
                <span class="text-muted-foreground/60 text-[10px]">python</span>
              </div>
              <div class="font-mono text-xs space-y-1">
                <div class="text-foreground/90 font-medium">dict(row.items())</div>
                <div class="text-[11px] text-muted-foreground">unbounded stream</div>
                <div class="text-[10px] text-muted-foreground/60">dynamic kv push</div>
              </div>

              <!-- Right Output Port Handle -->
              <div class="absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-border border-2 border-background" title="Output Port"></div>
            </div>

            <!-- Wire 2 -> 3 (Clean Bezier Wire with Flow Indicator) -->
            <div class="shrink-0 flex items-center justify-center font-mono text-xs text-muted-foreground/40">
              <span>→</span>
            </div>

            <!-- Node 3: Quicksilver KV Cache Mesh -->
            <div class="w-48 sm:w-52 rounded-lg border border-border/70 bg-card p-3.5 space-y-2.5 shadow-xs relative group">
              <!-- Left Input Port Handle -->
              <div class="absolute -left-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-border border-2 border-background" title="Input Port"></div>
              
              <div class="flex items-center justify-between font-mono text-[11px] pb-1.5 border-b border-border/40">
                <span class="text-blue-500 font-medium">features.json</span>
                <span class="text-muted-foreground/60 text-[10px]">quicksilver kv</span>
              </div>
              <div class="font-mono text-xs space-y-1">
                <div class="text-foreground/90 font-medium">280 feature keys</div>
                <div class="text-[11px] text-muted-foreground">replicated mesh</div>
                <div class="text-[10px] text-muted-foreground/60">330 edge pops</div>
              </div>

              <!-- Right Output Port Handle -->
              <div class="absolute -right-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-border border-2 border-background" title="Output Port"></div>
            </div>

            <!-- Wire 3 -> 4 (Fatal Invariant Breach Wire) -->
            <div class="shrink-0 flex flex-col items-center justify-center font-mono text-xs text-rose-500 gap-0.5">
              <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-rose-500/10 border border-rose-500/20">c/b = 1.40</span>
              <span>✕ →</span>
            </div>

            <!-- Node 4: Rust L7 Reverse Proxy Buffer (SELECTED NODE in Studio) -->
            <div class="w-48 sm:w-52 rounded-lg border-2 border-blue-500 bg-card p-3.5 space-y-2.5 shadow-xs relative group ring-4 ring-blue-500/10">
              <!-- Left Input Port Handle -->
              <div class="absolute -left-1.5 top-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-rose-500 border-2 border-background" title="Breach Input Port"></div>
              
              <!-- Figma-style corner selection handles (isolated overlay hitting exact corner vertices) -->
              <div class="pointer-events-none absolute -inset-[2px]">
                <div class="absolute top-0 left-0 -translate-x-1/2 -translate-y-1/2 w-2 h-2 bg-blue-500 border border-background"></div>
                <div class="absolute top-0 right-0 translate-x-1/2 -translate-y-1/2 w-2 h-2 bg-blue-500 border border-background"></div>
                <div class="absolute bottom-0 left-0 -translate-x-1/2 translate-y-1/2 w-2 h-2 bg-blue-500 border border-background"></div>
                <div class="absolute bottom-0 right-0 translate-x-1/2 translate-y-1/2 w-2 h-2 bg-blue-500 border border-background"></div>
              </div>

              <div class="flex items-center justify-between font-mono text-[11px] pb-1.5 border-b border-border/40">
                <span class="text-rose-500 font-medium">buffer.rs</span>
                <span class="text-blue-500 font-semibold text-[10px]">selected</span>
              </div>
              <div class="font-mono text-xs space-y-1">
                <div class="text-foreground/90 font-medium">[Feature; 200]</div>
                <div class="text-[11px] text-rose-500 font-semibold">TryFromSliceError</div>
                <div class="text-[10px] text-rose-400">panic on item #201</div>
              </div>
            </div>

          </div>

          <!-- In-Canvas Invariant Remediation Callout -->
          <div class="mt-4 rounded-lg border border-border/60 bg-muted/40 p-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 font-mono text-xs">
            <div class="flex items-center gap-2.5">
              <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
              <span class="text-foreground font-medium">synthesized dual-zone partition:</span>
              <span class="text-muted-foreground hidden lg:inline">pin 128 core rules + 72 adaptive features (drop 80 untracked)</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="text-emerald-500 font-bold">0 b heap</span>
              <span class="text-muted-foreground/30">·</span>
              <span class="text-emerald-500 font-bold">7.66 ns p99</span>
            </div>
          </div>

        </div>

        <!-- Right Studio Inspector Panel (Desktop) -->
        <div class="w-64 bg-muted/20 border-l border-border/40 p-4 shrink-0 flex flex-col justify-between hidden md:flex font-mono text-xs">
          <div class="space-y-4">
            <div class="pb-2 border-b border-border/40">
              <div class="text-[10px] uppercase text-muted-foreground/60 tracking-wider">inspector</div>
              <div class="text-sm font-medium text-foreground lowercase">crates/proxy/buffer.rs</div>
            </div>

            <div class="space-y-2 text-[11px]">
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">buffer type</span>
                <span class="text-foreground">fixed stack</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">capacity</span>
                <span class="text-foreground font-semibold">200 items</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">cache lines</span>
                <span class="text-foreground">25 l1 (1,600 b)</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">heap alloc</span>
                <span class="text-emerald-500 font-bold">0 bytes</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">in-degree</span>
                <span class="text-foreground font-semibold">280 cols</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-muted-foreground">cardinality ratio</span>
                <span class="text-rose-500 font-bold">1.40 (breach)</span>
              </div>
            </div>

            <!-- Invariant Diagnostics Block -->
            <div class="p-2.5 rounded border border-rose-500/20 bg-rose-500/5 space-y-1 text-[11px]">
              <div class="text-rose-500 font-medium">invariant failed</div>
              <div class="text-muted-foreground leading-relaxed">
                dynamic reflection exceeds static bounds. proxy crashes at line rate.
              </div>
            </div>
          </div>

          <div class="pt-3 border-t border-border/40 text-[10px] text-muted-foreground">
            <span>action: auto-partition ready</span>
          </div>
        </div>

      </div>
    </div>

    <!-- 3 Grounded Technical Capabilities -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-left">
      
      <!-- Capability 1 -->
      <div class="space-y-2.5">
        <p class="text-xs font-mono text-muted-foreground">01 / topology modeling</p>
        <h3 class="text-xl font-light text-foreground lowercase">
          spatial dag architecture.
        </h3>
        <p class="text-sm text-muted-foreground font-light leading-relaxed">
          visualizes cross-language data paths as an interactive directed acyclic graph. connects analytical ddl tables, intermediate serializers, distributed caches, and fixed-capacity runtime memory.
        </p>
      </div>

      <!-- Capability 2 -->
      <div class="space-y-2.5">
        <p class="text-xs font-mono text-muted-foreground">02 / cardinality verification</p>
        <h3 class="text-xl font-light text-foreground lowercase">
          cardinality risk ratio analysis.
        </h3>
        <p class="text-sm text-muted-foreground font-light leading-relaxed">
          calculates the mathematical ratio between upstream schema cardinality and downstream memory bounds (c / b). flags any path where dynamic reflection can overflow a fixed-capacity buffer before deployment.
        </p>
      </div>

      <!-- Capability 3 -->
      <div class="space-y-2.5">
        <p class="text-xs font-mono text-muted-foreground">03 / automated remediation</p>
        <h3 class="text-xl font-light text-foreground lowercase">
          dual-zone buffer partitioning.
        </h3>
        <p class="text-sm text-muted-foreground font-light leading-relaxed">
          analyzes the reachability graph to partition schemas across language boundaries, preserving zero-heap hot paths (7.66 ns p99) while gracefully shedding unmapped dynamic overflow without runtime panics.
        </p>
      </div>

    </div>

  </div>
</section>

<style>
  /* Scrollbar only appears when directly hovering over the canvas container */
  .studio-canvas-scroll {
    scrollbar-width: none; /* Firefox: completely hidden by default */
    -ms-overflow-style: none; /* IE/Edge */
  }

  .studio-canvas-scroll::-webkit-scrollbar {
    height: 5px;
    background: transparent;
  }

  .studio-canvas-scroll::-webkit-scrollbar-track {
    background: transparent;
  }

  .studio-canvas-scroll::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 9999px;
    transition: background 0.15s ease-in-out;
  }

  /* Only reveal thumb on hover directly over the canvas container */
  .studio-canvas-scroll:hover {
    scrollbar-width: thin;
    scrollbar-color: rgba(140, 140, 140, 0.35) transparent;
  }

  .studio-canvas-scroll:hover::-webkit-scrollbar-thumb {
    background: rgba(140, 140, 140, 0.35);
  }

  .studio-canvas-scroll:hover::-webkit-scrollbar-thumb:hover {
    background: rgba(140, 140, 140, 0.6);
  }
</style>
