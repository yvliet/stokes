---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="docs | stokes"
  description="Stokes Documentation placeholder."
>
  <div class="flex min-h-screen flex-col bg-background text-foreground transition-colors selection:bg-neutral-200 dark:selection:bg-neutral-800">
    <Navbar />
    
    <main class="flex-1 flex flex-col items-center justify-center px-6 py-24 text-center">
      <div class="max-w-md mx-auto space-y-4">
        <p class="text-sm font-mono text-muted-foreground">docs</p>
        <h1 class="text-4xl sm:text-5xl font-extralight tracking-tight text-foreground">
          placeholder
        </h1>
        <p class="text-sm text-muted-foreground font-light">
          documentation is coming soon. view the <a href="https://github.com/yvliet/stokes#readme" target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 text-foreground hover:text-foreground/80">github readme</a> in the meantime.
        </p>
        <div class="pt-4">
          <a 
            href="/" 
            class="inline-flex items-center justify-center text-xs font-mono px-4 py-2 rounded-full border border-border/80 hover:bg-muted text-foreground transition-colors"
          >
            ← back to landing
          </a>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</BaseLayout>
