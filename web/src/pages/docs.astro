---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import { DocsShell } from '../components/docs/DocsShell';
---

<BaseLayout 
  title="docs | technical architecture & invariant reference | stokes"
  description="Technical systems documentation for Stokes: cross-boundary contracts, semantic AST hashing, poly-repo coordination, and untyped seam verification."
>
  <div class="flex min-h-screen flex-col bg-background text-foreground transition-colors selection:bg-neutral-200 dark:selection:bg-neutral-800">
    <Navbar />
    
    <main class="flex-1 w-full">
      <DocsShell client:load />
    </main>
  </div>
</BaseLayout>
