{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerificationArtifactDigest",
  "description": "Machine-authoritative cryptographic boundary lockfile schema for stokes.lock.",
  "type": "object",
  "required": [
    "stokes_version",
    "generated_at",
    "target_repository",
    "schema_digests",
    "boundary_contracts",
    "verification_results",
    "master_digest"
  ],
  "properties": {
    "stokes_version": {
      "type": "string",
      "description": "Stokes version that generated this lockfile (e.g. 0.2.0)."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of lockfile generation."
    },
    "target_repository": {
      "type": "string",
      "description": "Path to the evaluated repository."
    },
    "schema_digests": {
      "type": "object",
      "description": "SHA-256 hashes of source files constituting contract boundaries.",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "boundary_contracts": {
      "type": "object",
      "required": ["max_active_features", "zone_0_capacity", "zone_1_capacity", "max_canonical_columns"],
      "properties": {
        "max_active_features": {
          "type": "integer",
          "description": "Downstream fixed buffer capacity (B_downstream)."
        },
        "zone_0_capacity": {
          "type": "integer",
          "description": "Core reserved zone capacity (slots 0..127)."
        },
        "zone_1_capacity": {
          "type": "integer",
          "description": "Dynamic adaptive zone capacity (slots 128..199)."
        },
        "max_canonical_columns": {
          "type": "integer",
          "description": "Maximum canonical upstream column count (C_upstream)."
        },
        "observed_upstream_cardinality": {
          "type": "integer",
          "description": "Observed cardinality at last scan."
        },
        "cardinality_risk_ratio": {
          "type": "number",
          "description": "Risk = observed_upstream_cardinality / max_active_features."
        }
      }
    },
    "verification_results": {
      "type": "object",
      "properties": {
        "fuzz_cases_passed": { "type": "integer" },
        "fuzz_cases_total": { "type": "integer" },
        "criterion_inplace_ns": { "type": "number" },
        "criterion_heap_ns": { "type": "number" },
        "float_vectors_sanitized": { "type": "integer" },
        "violations_detected": { "type": "integer" },
        "violations_resolved": { "type": "integer" },
        "heap_allocation_bytes": { "type": "integer" }
      }
    },
    "ci_gate_status": {
      "type": "string",
      "enum": ["PASSED", "FAILED", "PENDING"],
      "description": "Result of stokes verify --strict CI gate evaluation."
    },
    "master_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest of the entire lockfile content (excluding this field)."
    }
  },
  "additionalProperties": false
}
